---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import { DEFAULT_LOCALE, LOCALES, LOCALE_LABELS, TRANSLATED_PATHS, localizedPath, stripLocalePrefix, type Locale } from '../i18n/config';

interface Props {
	lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;

const dicts = {
	zh: {
		home: '首页', products: '产品', services: '服务与定价', dao: 'DAO', garden: '🌱 自留区', contact: '联系',
		tools: '工具总览', md2docx: '在线 Markdown 转 Word', formatter: 'docx-formatter-cn', docs: '使用文档',
		blog: '写作', notes: '笔记', about: '关于我',
	},
	en: {
		home: 'Home', products: 'Products', services: 'Services & Pricing', dao: 'DAO', garden: '🌱 Garden', contact: 'Contact',
		tools: 'All Tools', md2docx: 'Online Markdown → Word', formatter: 'docx-formatter-cn', docs: 'Docs',
		blog: 'Blog', notes: 'Notes', about: 'About',
	},
	ja: {
		home: 'ホーム', products: '製品', services: 'サービスと料金', dao: 'DAO', garden: '🌱 ガーデン', contact: 'お問い合わせ',
		tools: 'ツール一覧', md2docx: 'オンライン Markdown → Word', formatter: 'docx-formatter-cn', docs: 'ドキュメント',
		blog: 'ブログ', notes: 'ノート', about: '私について',
	},
} as const;

const t = dicts[lang];

// Prefix hrefs with the locale only when the page actually has a translation.
function L(path: string): string {
	if (lang === DEFAULT_LOCALE || !TRANSLATED_PATHS.includes(path)) return path;
	return localizedPath(path, lang);
}

const productLinks = [
	{ href: L('/tools'), text: t.tools },
	{ href: '/tools/md2docx', text: t.md2docx },
	{ href: '/projects/docx-formatter-cn', text: t.formatter },
	{ href: '/projects/docx-formatter-docs', text: t.docs },
];

const gardenLinks = [
	{ href: '/blog', text: t.blog },
	{ href: '/notes', text: t.notes },
	{ href: L('/about'), text: t.about },
];

// DAO 页面只有中文版，下拉项固定中文文案
const daoLinks = [
	{ href: '/dao', text: '总览' },
	{ href: '/dao/proposals', text: '提案' },
	{ href: '/dao/members', text: '成员' },
	{ href: '/dao/charter', text: '章程' },
	{ href: '/ledger', text: '公开账本' },
];

// Language switcher targets: same page when translated, locale home otherwise.
const { base } = stripLocalePrefix(Astro.url.pathname);
const switchTarget = TRANSLATED_PATHS.includes(base) ? base : '/';
const langOptions = LOCALES.map((l) => ({
	locale: l,
	label: LOCALE_LABELS[l],
	href: localizedPath(switchTarget, l),
	active: l === lang,
}));
---

<header>
	<nav>
		<h2><a href={L('/')}>{SITE_TITLE}</a></h2>
		<div class="internal-links" id="nav-links">
			<HeaderLink href={L('/')}>{t.home}</HeaderLink>

			<div class="dropdown" data-dropdown>
				<button class="dropdown-toggle" aria-expanded="false" aria-haspopup="true">
					{t.products}
					<span class="dropdown-chevron" aria-hidden="true">▾</span>
				</button>
				<div class="dropdown-menu">
					{productLinks.map((link) => (
						<a href={link.href}>{link.text}</a>
					))}
				</div>
			</div>

			<HeaderLink href={L('/services')}>{t.services}</HeaderLink>

			<div class="dropdown" data-dropdown>
				<button class="dropdown-toggle" aria-expanded="false" aria-haspopup="true">
					{t.dao}
					<span class="dropdown-chevron" aria-hidden="true">▾</span>
				</button>
				<div class="dropdown-menu">
					{daoLinks.map((link) => (
						<a href={link.href}>{link.text}</a>
					))}
				</div>
			</div>

			<div class="dropdown" data-dropdown>
				<button class="dropdown-toggle" aria-expanded="false" aria-haspopup="true">
					{t.garden}
					<span class="dropdown-chevron" aria-hidden="true">▾</span>
				</button>
				<div class="dropdown-menu">
					{gardenLinks.map((link) => (
						<a href={link.href}>{link.text}</a>
					))}
				</div>
			</div>

			<HeaderLink href={L('/contact')}>{t.contact}</HeaderLink>
		</div>
		<div class="nav-actions">
			<div class="dropdown lang-switcher" data-dropdown>
				<button class="dropdown-toggle nav-icon-btn" aria-expanded="false" aria-haspopup="true" aria-label="切换语言 / Language">
					🌐
				</button>
				<div class="dropdown-menu dropdown-menu-right">
					{langOptions.map((opt) => (
						<a href={opt.href} data-lang-option={opt.locale} class={opt.active ? 'active' : undefined}>{opt.label}</a>
					))}
				</div>
			</div>
			<button id="theme-toggle" aria-label="切换主题" title="切换主题">
				<span class="theme-icon" id="theme-icon">🌙</span>
			</button>
			<button id="menu-toggle" aria-label="打开菜单" aria-expanded="false" aria-controls="nav-links">
				<span class="menu-icon" aria-hidden="true"></span>
			</button>
		</div>
	</nav>
</header>

<script is:inline>
	(function() {
		const root = document.documentElement;
		const saved = localStorage.getItem('theme');
		const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
		const theme = saved || (prefersDark ? 'dark' : 'light');
		root.setAttribute('data-theme', theme);
		const icon = document.getElementById('theme-icon');
		if (icon) icon.textContent = theme === 'dark' ? '☀️' : '🌙';
	})();

	document.addEventListener('DOMContentLoaded', function() {
		// Language switcher: remember explicit choice
		document.querySelectorAll('[data-lang-option]').forEach(function(link) {
			link.addEventListener('click', function() {
				try { localStorage.setItem('lang', link.getAttribute('data-lang-option')); } catch (e) {}
			});
		});

		const toggle = document.getElementById('theme-toggle');
		const icon = document.getElementById('theme-icon');
		const root = document.documentElement;
		if (toggle) {
			toggle.addEventListener('click', function() {
				const current = root.getAttribute('data-theme');
				const next = current === 'dark' ? 'light' : 'dark';
				root.setAttribute('data-theme', next);
				localStorage.setItem('theme', next);
				if (icon) icon.textContent = next === 'dark' ? '☀️' : '🌙';
			});
		}

		const menuToggle = document.getElementById('menu-toggle');
		const navLinks = document.getElementById('nav-links');
		function closeMenu() {
			if (!navLinks) return;
			navLinks.classList.remove('open');
			if (menuToggle) {
				menuToggle.setAttribute('aria-expanded', 'false');
				menuToggle.setAttribute('aria-label', '打开菜单');
			}
		}
		if (menuToggle && navLinks) {
			menuToggle.addEventListener('click', function() {
				const isOpen = navLinks.classList.toggle('open');
				menuToggle.setAttribute('aria-expanded', String(isOpen));
				menuToggle.setAttribute('aria-label', isOpen ? '关闭菜单' : '打开菜单');
			});
			navLinks.querySelectorAll('a').forEach((link) => {
				link.addEventListener('click', closeMenu);
			});
			document.addEventListener('click', function(event) {
				const target = event.target;
				if (!(target instanceof Node)) return;
				if (!navLinks.contains(target) && !menuToggle.contains(target)) {
					closeMenu();
				}
			});
		}

		// Dropdowns
		document.querySelectorAll('[data-dropdown]').forEach(function(dropdown) {
			const btn = dropdown.querySelector('.dropdown-toggle');
			const menu = dropdown.querySelector('.dropdown-menu');
			if (!btn || !menu) return;

			function open() {
				dropdown.classList.add('open');
				btn.setAttribute('aria-expanded', 'true');
			}
			function close() {
				dropdown.classList.remove('open');
				btn.setAttribute('aria-expanded', 'false');
			}

			btn.addEventListener('click', function(e) {
				e.stopPropagation();
				const isOpen = dropdown.classList.contains('open');
				// Close others
				document.querySelectorAll('[data-dropdown].open').forEach(function(d) {
					if (d !== dropdown) d.classList.remove('open');
				});
				if (isOpen) close(); else open();
			});

			dropdown.addEventListener('mouseenter', open);
			dropdown.addEventListener('mouseleave', close);

			menu.querySelectorAll('a').forEach(function(link) {
				link.addEventListener('click', close);
			});
		});

		document.addEventListener('click', function() {
			document.querySelectorAll('[data-dropdown].open').forEach(function(d) {
				d.classList.remove('open');
				const btn = d.querySelector('.dropdown-toggle');
				if (btn) btn.setAttribute('aria-expanded', 'false');
			});
		});
	});
</script>

<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: color-mix(in srgb, var(--bg) 85%, transparent);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
		position: sticky;
		top: 0;
		z-index: 100;
	}
	h2 {
		margin: 0;
		font-size: 1.05em;
		letter-spacing: 0.01em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: var(--wide-width);
		margin: 0 auto;
	}
	.internal-links {
		display: flex;
		align-items: center;
	}
	.internal-links > :global(a),
	.internal-links > .dropdown > .dropdown-toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.2em;
		padding: 0.95em 0.65em;
		color: var(--text-secondary);
		border-bottom: 2px solid transparent;
		text-decoration: none;
		background: none;
		border: none;
		font: inherit;
		cursor: pointer;
		font-size: 0.92em;
		transition: color 0.15s;
	}
	.internal-links > :global(a:hover),
	.internal-links > .dropdown > .dropdown-toggle:hover {
		color: var(--text);
	}
	.internal-links > :global(a.active) {
		color: var(--text);
		border-bottom-color: var(--accent);
	}
	.dropdown {
		position: relative;
	}
	.dropdown-chevron {
		font-size: 0.75em;
		transition: transform 0.2s;
	}
	.dropdown.open .dropdown-chevron {
		transform: rotate(180deg);
	}
	.dropdown-menu {
		position: absolute;
		top: calc(100% - 2px);
		left: 0;
		min-width: 200px;
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-lg);
		padding: var(--space-2);
		z-index: 101;
		opacity: 0;
		visibility: hidden;
		transform: translateY(4px);
		pointer-events: none;
		transition:
			opacity 0.18s ease,
			transform 0.18s ease,
			visibility 0s linear 0.18s;
	}
	.dropdown.open .dropdown-menu {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
		pointer-events: auto;
		transition:
			opacity 0.18s ease,
			transform 0.18s ease;
	}
	.dropdown-menu a {
		display: block;
		padding: 0.55em 0.85em;
		border-radius: var(--radius-md);
		color: var(--text);
		text-decoration: none;
		font-size: 0.9em;
		white-space: nowrap;
	}
	.dropdown-menu a:hover {
		background: var(--accent-soft);
		color: var(--accent);
	}
	.nav-actions {
		display: flex;
		align-items: center;
		gap: 0.3em;
	}
	.nav-icon-btn {
		background: none;
		border: none;
		cursor: pointer;
		font-size: 1.1em;
		padding: 0.45em;
		border-radius: var(--radius-sm);
		color: var(--text-secondary);
		transition: background 0.2s, color 0.15s;
	}
	.nav-icon-btn:hover {
		background: var(--accent-soft);
		color: var(--accent);
	}
	.lang-switcher .dropdown-menu {
		min-width: 120px;
	}
	.dropdown-menu-right {
		left: auto;
		right: 0;
	}
	.dropdown-menu a.active {
		color: var(--accent);
		font-weight: 700;
	}
	#theme-toggle,
	#menu-toggle {
		background: none;
		border: none;
		cursor: pointer;
		font-size: 1.1em;
		padding: 0.45em;
		border-radius: var(--radius-sm);
		color: var(--text-secondary);
		transition: background 0.2s, color 0.15s;
	}
	#theme-toggle:hover,
	#menu-toggle:hover {
		background: var(--accent-soft);
		color: var(--accent);
	}
	#menu-toggle {
		display: none;
	}
	.menu-icon {
		display: block;
		width: 1.2em;
		height: 0.15em;
		background: currentColor;
		border-radius: 2px;
		position: relative;
	}
	.menu-icon::before,
	.menu-icon::after {
		content: '';
		position: absolute;
		left: 0;
		width: 100%;
		height: 0.15em;
		background: currentColor;
		border-radius: 2px;
		transition: transform 0.2s, top 0.2s;
	}
	.menu-icon::before {
		top: -0.4em;
	}
	.menu-icon::after {
		top: 0.4em;
	}
	#menu-toggle[aria-expanded='true'] .menu-icon {
		background: transparent;
	}
	#menu-toggle[aria-expanded='true'] .menu-icon::before {
		top: 0;
		transform: rotate(45deg);
	}
	#menu-toggle[aria-expanded='true'] .menu-icon::after {
		top: 0;
		transform: rotate(-45deg);
	}
	@media (max-width: 720px) {
		.internal-links {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			background: var(--bg-elevated);
			box-shadow: var(--shadow-lg);
			padding: 0.5em 1em 1em;
			border-bottom: 1px solid var(--border);
		}
		.internal-links.open {
			display: flex;
		}
		.internal-links > :global(a),
		.internal-links > .dropdown > .dropdown-toggle {
			padding: 0.85em 0.5em;
			border-bottom: none;
			border-left: 3px solid transparent;
			justify-content: space-between;
			font-size: 1em;
		}
		.internal-links > :global(a.active) {
			border-left-color: var(--accent);
			border-bottom-color: transparent;
		}
		.dropdown-menu {
			position: static;
			display: none;
			opacity: 1;
			visibility: visible;
			transform: none;
			pointer-events: auto;
			transition: none;
			box-shadow: none;
			border: none;
			background: transparent;
			padding: 0 0 0 1em;
		}
		.dropdown.open .dropdown-menu {
			display: block;
		}
		.dropdown-menu a {
			padding: 0.55em 0.8em;
		}
		#menu-toggle {
			display: inline-flex;
			align-items: center;
			justify-content: center;
		}
	}
</style>
