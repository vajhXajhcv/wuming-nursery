---
/**
 * 成员门槛引导卡：本机没有任何 dao:key:* 私钥时显示，引导先去 /dao/join。
 * 默认自动检测（auto=true）；auto=false 时保持隐藏，由页面脚本按需切换
 * （如提案详情页仅在提案处于投票期时才显示）。
 */
interface Props {
	auto?: boolean;
}
const { auto = true } = Astro.props;
---

<div class="member-gate" data-auto={auto ? '1' : '0'} style="display:none">
	本机没有可用身份。请先到 <a href="/dao/join">加入页</a> 生成密钥并申请成为成员，或导入已有私钥。
</div>

<style is:global>
	.member-gate {
		padding: 0.7em 1em;
		border-radius: var(--radius-md);
		background: var(--accent-soft);
		font-size: 0.88em;
		line-height: 1.7;
		margin-bottom: 1em;
	}
</style>

<script>
	import { listMemberKeys } from '../../lib/dao-ui';

	document.querySelectorAll('.member-gate[data-auto="1"]').forEach((el) => {
		if (listMemberKeys().length === 0) (el as HTMLElement).style.display = '';
	});
</script>
