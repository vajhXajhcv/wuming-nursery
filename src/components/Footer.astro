---
const today = new Date();

const productLinks = [
	{ href: '/tools', text: '工具总览' },
	{ href: '/tools/md2docx', text: '在线 Markdown 转 Word' },
	{ href: '/projects/docx-formatter-cn', text: 'docx-formatter-cn' },
	{ href: '/projects/docx-formatter-docs', text: '使用文档' },
	{ href: '/pricing', text: '定价方案' },
];

const serviceLinks = [
	{ href: '/services', text: '全部服务' },
	{ href: '/services/thesis-formatting', text: '论文排版服务' },
	{ href: '/services/custom-development', text: '软件定制开发' },
	{ href: '/contact', text: '开始咨询' },
];

const gardenLinks = [
	{ href: '/blog', text: '写作' },
	{ href: '/notes', text: '笔记' },
	{ href: '/about', text: '关于我' },
	{ href: '/archive', text: '归档' },
	{ href: '/ledger', text: '公开账本' },
];
---

<footer>
	<div class="footer-grid">
		<div class="footer-col">
			<div class="footer-brand">🌱 无名苗圃</div>
			<p class="footer-desc">独立开发者 · 技术创作者 · 一人公司探索者。</p>
		</div>
		<div class="footer-col">
			<h4>产品</h4>
			<ul>
				{productLinks.map((link) => (
					<li><a href={link.href}>{link.text}</a></li>
				))}
			</ul>
		</div>
		<div class="footer-col">
			<h4>服务</h4>
			<ul>
				{serviceLinks.map((link) => (
					<li><a href={link.href}>{link.text}</a></li>
				))}
			</ul>
		</div>
		<div class="footer-col">
			<h4>自留区</h4>
			<ul>
				{gardenLinks.map((link) => (
					<li><a href={link.href}>{link.text}</a></li>
				))}
			</ul>
		</div>
	</div>
	<div class="copyright">&copy; {today.getFullYear()} 无名苗圃. All rights reserved.</div>
	<div class="site-runtime">本站自 2026 年 5 月 7 日上线，已运行 <span id="site-runtime">计算中…</span></div>
	<div class="music-credit">
		背景音乐：<a href="https://incompetech.com" target="_blank" rel="noopener">Kevin MacLeod (incompetech.com)</a>，<a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a> 授权
	</div>
</footer>

<!-- Back to Top -->
<button id="back-to-top" aria-label="返回顶部" title="返回顶部">
	<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
		<polyline points="18 15 12 9 6 15"></polyline>
	</svg>
</button>

<script is:inline>
	document.addEventListener('DOMContentLoaded', function() {
		var el = document.getElementById('site-runtime');
		if (!el) return;
		var launch = new Date('2026-05-07T00:00:00+08:00').getTime();
		function pad(n) { return n < 10 ? '0' + n : '' + n; }
		function tick() {
			var diff = Math.max(0, Date.now() - launch);
			var days = Math.floor(diff / 86400000);
			var hours = Math.floor(diff % 86400000 / 3600000);
			var minutes = Math.floor(diff % 3600000 / 60000);
			var seconds = Math.floor(diff % 60000 / 1000);
			el.textContent = days + ' 天 ' + pad(hours) + ' 时 ' + pad(minutes) + ' 分 ' + pad(seconds) + ' 秒';
		}
		tick();
		setInterval(tick, 1000);
	});
</script>

<script is:inline>
	document.addEventListener('DOMContentLoaded', function() {
		var btn = document.getElementById('back-to-top');
		if (!btn) return;
		function onScroll() {
			if (window.scrollY > 300) {
				btn.classList.add('visible');
			} else {
				btn.classList.remove('visible');
			}
		}
		window.addEventListener('scroll', onScroll, { passive: true });
		onScroll();
		btn.addEventListener('click', function() {
			window.scrollTo({ top: 0, behavior: 'smooth' });
		});
	});
</script>

<style>
	footer {
		padding: 2.5em 1em 1.5em;
		border-top: 1px solid var(--border);
		color: var(--text-secondary);
	}
	.footer-grid {
		max-width: 960px;
		margin: 0 auto 2em;
		display: grid;
		grid-template-columns: 1.5fr 1fr 1fr 1fr;
		gap: 2em;
	}
	.footer-brand {
		font-weight: 700;
		color: var(--text);
		font-size: 1em;
		margin-bottom: 0.5em;
	}
	.footer-desc {
		font-size: 0.85em;
		line-height: 1.6;
		margin: 0;
	}
	.footer-col h4 {
		margin: 0 0 0.8em;
		font-size: 0.85em;
		font-weight: 600;
		color: var(--text-secondary);
		letter-spacing: 0.05em;
	}
	.footer-col ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.footer-col li {
		margin: 0.4em 0;
	}
	.footer-col a {
		color: var(--text-secondary);
		text-decoration: none;
		font-size: 0.85em;
		transition: color 0.15s;
	}
	.footer-col a:hover {
		color: var(--accent);
	}
	.copyright {
		text-align: center;
		font-size: 0.8em;
		padding-top: 1.5em;
		border-top: 1px solid var(--border);
		max-width: 960px;
		margin: 0 auto;
	}
	.site-runtime {
		text-align: center;
		font-size: 0.8em;
		max-width: 960px;
		margin: 0.4em auto 0;
		font-variant-numeric: tabular-nums;
	}
	.music-credit {
		text-align: center;
		font-size: 0.72em;
		color: var(--text-secondary);
		max-width: 960px;
		margin: 0.6em auto 0;
	}
	.music-credit a {
		color: var(--text-secondary);
	}
	.music-credit a:hover {
		color: var(--accent);
	}
	#back-to-top {
		position: fixed;
		bottom: 2em;
		right: 2em;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: var(--accent);
		color: white;
		border: none;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
		opacity: 0;
		transform: translateY(20px);
		transition: opacity 0.3s ease, transform 0.3s ease, background 0.2s;
		z-index: 99;
		pointer-events: none;
	}
	#back-to-top.visible {
		opacity: 1;
		transform: translateY(0);
		pointer-events: auto;
	}
	#back-to-top:hover {
		background: var(--accent-dark);
		transform: translateY(-2px);
	}
	@media (max-width: 720px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
			gap: 1.5em;
		}
		.footer-col:first-child {
			grid-column: 1 / -1;
		}
		#back-to-top {
			bottom: 1em;
			right: 1em;
			width: 40px;
			height: 40px;
		}
	}
</style>
