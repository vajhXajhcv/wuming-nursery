---
import { DEFAULT_LOCALE, TRANSLATED_PATHS, localizedPath, type Locale } from '../i18n/config';

interface Props {
	lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const today = new Date();

const dicts = {
	zh: {
		desc: '独立开发者 · 技术创作者 · 一人公司探索者。',
		products: '产品', services: '服务', garden: '自留区',
		tools: '工具总览', md2docx: '在线 Markdown 转 Word', formatter: 'docx-formatter-cn', docs: '使用文档', pricing: '定价方案',
		allServices: '全部服务', thesis: '论文排版服务', customDev: '软件定制开发', contact: '开始咨询',
		blog: '写作', notes: '笔记', about: '关于我', archive: '归档', ledger: '公开账本',
		rights: '无名苗圃. All rights reserved.',
		runtimePrefix: '本站自 2026 年 5 月 7 日上线，已运行 ',
		musicCredit: '背景音乐：',
		license: '授权',
	},
	en: {
		desc: 'Indie developer · tech writer · one-person company explorer.',
		products: 'Products', services: 'Services', garden: 'Garden',
		tools: 'All Tools', md2docx: 'Online Markdown → Word', formatter: 'docx-formatter-cn', docs: 'Docs', pricing: 'Pricing',
		allServices: 'All Services', thesis: 'Thesis Formatting', customDev: 'Custom Development', contact: 'Get in Touch',
		blog: 'Blog', notes: 'Notes', about: 'About', archive: 'Archive', ledger: 'Open Ledger',
		rights: 'Wuming Nursery. All rights reserved.',
		runtimePrefix: 'Online since May 7, 2026 — running for ',
		musicCredit: 'Background music: ',
		license: 'license',
	},
	ja: {
		desc: '独立開発者 · テックライター · 一人会社の探求者。',
		products: '製品', services: 'サービス', garden: 'ガーデン',
		tools: 'ツール一覧', md2docx: 'オンライン Markdown → Word', formatter: 'docx-formatter-cn', docs: 'ドキュメント', pricing: '料金',
		allServices: 'サービス一覧', thesis: '論文フォーマットサービス', customDev: 'ソフトウェア受託開発', contact: 'お問い合わせ',
		blog: 'ブログ', notes: 'ノート', about: '私について', archive: 'アーカイブ', ledger: '公開台帳',
		rights: 'Wuming Nursery. All rights reserved.',
		runtimePrefix: '2026年5月7日開設 · 運営時間 ',
		musicCredit: 'BGM：',
		license: 'ライセンス',
	},
} as const;

const t = dicts[lang];

function L(path: string): string {
	if (lang === DEFAULT_LOCALE || !TRANSLATED_PATHS.includes(path)) return path;
	return localizedPath(path, lang);
}

const productLinks = [
	{ href: L('/tools'), text: t.tools },
	{ href: '/tools/md2docx', text: t.md2docx },
	{ href: '/projects/docx-formatter-cn', text: t.formatter },
	{ href: '/projects/docx-formatter-docs', text: t.docs },
	{ href: L('/pricing'), text: t.pricing },
];

const serviceLinks = [
	{ href: L('/services'), text: t.allServices },
	{ href: L('/services/thesis-formatting'), text: t.thesis },
	{ href: L('/services/custom-development'), text: t.customDev },
	{ href: L('/contact'), text: t.contact },
];

const gardenLinks = [
	{ href: '/blog', text: t.blog },
	{ href: '/notes', text: t.notes },
	{ href: L('/about'), text: t.about },
	{ href: '/archive', text: t.archive },
	{ href: '/ledger', text: t.ledger },
];
---

<footer>
	<div class="footer-grid">
		<div class="footer-col">
			<div class="footer-brand">🌱 无名苗圃</div>
			<p class="footer-desc">{t.desc}</p>
		</div>
		<div class="footer-col">
			<h4>{t.products}</h4>
			<ul>
				{productLinks.map((link) => (
					<li><a href={link.href}>{link.text}</a></li>
				))}
			</ul>
		</div>
		<div class="footer-col">
			<h4>{t.services}</h4>
			<ul>
				{serviceLinks.map((link) => (
					<li><a href={link.href}>{link.text}</a></li>
				))}
			</ul>
		</div>
		<div class="footer-col">
			<h4>{t.garden}</h4>
			<ul>
				{gardenLinks.map((link) => (
					<li><a href={link.href}>{link.text}</a></li>
				))}
			</ul>
		</div>
	</div>
	<div class="copyright">&copy; {today.getFullYear()} {t.rights}</div>
	<div class="site-runtime">{t.runtimePrefix}<span id="site-runtime" data-lang={lang}>…</span></div>
	<div class="music-credit">
		{t.musicCredit}<a href="https://incompetech.com" target="_blank" rel="noopener">Kevin MacLeod (incompetech.com)</a>，<a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a> {t.license}
	</div>
</footer>

<!-- Back to Top -->
<button id="back-to-top" aria-label="返回顶部" title="返回顶部">
	<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
		<polyline points="18 15 12 9 6 15"></polyline>
	</svg>
</button>

<script is:inline>
	document.addEventListener('DOMContentLoaded', function() {
		var el = document.getElementById('site-runtime');
		if (!el) return;
		var lang = el.getAttribute('data-lang') || 'zh';
		var launch = new Date('2026-05-07T00:00:00+08:00').getTime();
		function pad(n) { return n < 10 ? '0' + n : '' + n; }
		function tick() {
			var diff = Math.max(0, Date.now() - launch);
			var days = Math.floor(diff / 86400000);
			var hours = Math.floor(diff % 86400000 / 3600000);
			var minutes = Math.floor(diff % 3600000 / 60000);
			var seconds = Math.floor(diff % 60000 / 1000);
			if (lang === 'en') {
				el.textContent = days + 'd ' + pad(hours) + 'h ' + pad(minutes) + 'm ' + pad(seconds) + 's';
			} else if (lang === 'ja') {
				el.textContent = days + ' 日 ' + pad(hours) + ' 時間 ' + pad(minutes) + ' 分 ' + pad(seconds) + ' 秒';
			} else {
				el.textContent = days + ' 天 ' + pad(hours) + ' 时 ' + pad(minutes) + ' 分 ' + pad(seconds) + ' 秒';
			}
		}
		tick();
		setInterval(tick, 1000);
	});
</script>

<script is:inline>
	document.addEventListener('DOMContentLoaded', function() {
		var btn = document.getElementById('back-to-top');
		if (!btn) return;
		function onScroll() {
			if (window.scrollY > 300) {
				btn.classList.add('visible');
			} else {
				btn.classList.remove('visible');
			}
		}
		window.addEventListener('scroll', onScroll, { passive: true });
		onScroll();
		btn.addEventListener('click', function() {
			window.scrollTo({ top: 0, behavior: 'smooth' });
		});
	});
</script>

<style>
	footer {
		padding: 2.5em 1em 1.5em;
		border-top: 1px solid var(--border);
		color: var(--text-secondary);
	}
	.footer-grid {
		max-width: 960px;
		margin: 0 auto 2em;
		display: grid;
		grid-template-columns: 1.5fr 1fr 1fr 1fr;
		gap: 2em;
	}
	.footer-brand {
		font-weight: 700;
		color: var(--text);
		font-size: 1em;
		margin-bottom: 0.5em;
	}
	.footer-desc {
		font-size: 0.85em;
		line-height: 1.6;
		margin: 0;
	}
	.footer-col h4 {
		margin: 0 0 0.8em;
		font-size: 0.85em;
		font-weight: 600;
		color: var(--text-secondary);
		letter-spacing: 0.05em;
	}
	.footer-col ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.footer-col li {
		margin: 0.4em 0;
	}
	.footer-col a {
		color: var(--text-secondary);
		text-decoration: none;
		font-size: 0.85em;
		transition: color 0.15s;
	}
	.footer-col a:hover {
		color: var(--accent);
	}
	.copyright {
		text-align: center;
		font-size: 0.8em;
		padding-top: 1.5em;
		border-top: 1px solid var(--border);
		max-width: 960px;
		margin: 0 auto;
	}
	.site-runtime {
		text-align: center;
		font-size: 0.8em;
		max-width: 960px;
		margin: 0.4em auto 0;
		font-variant-numeric: tabular-nums;
	}
	.music-credit {
		text-align: center;
		font-size: 0.72em;
		color: var(--text-secondary);
		max-width: 960px;
		margin: 0.6em auto 0;
	}
	.music-credit a {
		color: var(--text-secondary);
	}
	.music-credit a:hover {
		color: var(--accent);
	}
	#back-to-top {
		position: fixed;
		bottom: 2em;
		right: 2em;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: var(--accent);
		color: white;
		border: none;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
		opacity: 0;
		transform: translateY(20px);
		transition: opacity 0.3s ease, transform 0.3s ease, background 0.2s;
		z-index: 99;
		pointer-events: none;
	}
	#back-to-top.visible {
		opacity: 1;
		transform: translateY(0);
		pointer-events: auto;
	}
	#back-to-top:hover {
		background: var(--accent-dark);
		transform: translateY(-2px);
	}
	@media (max-width: 720px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
			gap: 1.5em;
		}
		.footer-col:first-child {
			grid-column: 1 / -1;
		}
		#back-to-top {
			bottom: 1em;
			right: 1em;
			width: 40px;
			height: 40px;
		}
	}
</style>
