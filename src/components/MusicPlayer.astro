---
// 背景音乐播放器
// 曲目均为 Kevin MacLeod (incompetech.com) 作品，CC BY 4.0 授权
// https://creativecommons.org/licenses/by/4.0/
const tracks = [
	{
		src: '/music/gymnopedie-no-1.mp3',
		title: 'Gymnopédie No. 1',
		artist: 'Erik Satie · Kevin MacLeod 演奏',
		genre: '古典',
	},
	{
		src: '/music/deliberate-thought.mp3',
		title: 'Deliberate Thought',
		artist: 'Kevin MacLeod',
		genre: '氛围钢琴',
	},
	{
		src: '/music/airport-lounge.mp3',
		title: 'Airport Lounge',
		artist: 'Kevin MacLeod',
		genre: '轻松节拍',
	},
];
---

<div id="music-player" class="collapsed">
	<audio id="mp-audio" preload="none"></audio>

	<!-- 折叠状态：圆形按钮 -->
	<button id="mp-fab" aria-label="打开音乐播放器" title="背景音乐">
		<svg id="mp-fab-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M9 18V5l12-2v13"></path>
			<circle cx="6" cy="18" r="3"></circle>
			<circle cx="18" cy="16" r="3"></circle>
		</svg>
	</button>

	<!-- 展开面板 -->
	<div id="mp-panel" role="region" aria-label="背景音乐播放器">
		<div class="mp-top">
			<div class="mp-info">
				<div class="mp-title" id="mp-title"></div>
				<div class="mp-artist" id="mp-artist"></div>
			</div>
			<button id="mp-collapse" aria-label="收起播放器" title="收起">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<polyline points="6 9 12 15 18 9"></polyline>
				</svg>
			</button>
		</div>

		<div class="mp-progress" id="mp-progress">
			<div class="mp-progress-bar" id="mp-progress-bar"></div>
		</div>

		<div class="mp-controls">
			<button id="mp-prev" aria-label="上一首" title="上一首">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M6 5h2v14H6zM20 5v14L9 12z"/></svg>
			</button>
			<button id="mp-play" class="mp-play-btn" aria-label="播放" title="播放/暂停">
				<svg id="mp-icon-play" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
				<svg id="mp-icon-pause" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="display:none"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>
			</button>
			<button id="mp-next" aria-label="下一首" title="下一首">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16 5h2v14h-2zM4 5v14l11-7z"/></svg>
			</button>
			<input type="range" id="mp-volume" min="0" max="100" value="40" aria-label="音量" title="音量" />
		</div>

		<div class="mp-tracks" id="mp-tracks">
			{tracks.map((t, i) => (
				<button class="mp-track" data-index={i} data-src={t.src} data-title={t.title} data-artist={t.artist}>
					<span class="mp-track-genre">{t.genre}</span>
					<span class="mp-track-name">{t.title}</span>
				</button>
			))}
		</div>

		<div class="mp-credit">
			Music: <a href="https://incompetech.com" target="_blank" rel="noopener">Kevin MacLeod</a> ·
			<a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a>
		</div>
	</div>
</div>

<script is:inline>
	document.addEventListener('DOMContentLoaded', function () {
		var root = document.getElementById('music-player');
		if (!root) return;
		var audio = document.getElementById('mp-audio');
		var fab = document.getElementById('mp-fab');
		var panel = document.getElementById('mp-panel');
		var collapseBtn = document.getElementById('mp-collapse');
		var playBtn = document.getElementById('mp-play');
		var iconPlay = document.getElementById('mp-icon-play');
		var iconPause = document.getElementById('mp-icon-pause');
		var prevBtn = document.getElementById('mp-prev');
		var nextBtn = document.getElementById('mp-next');
		var volumeInput = document.getElementById('mp-volume');
		var titleEl = document.getElementById('mp-title');
		var artistEl = document.getElementById('mp-artist');
		var progress = document.getElementById('mp-progress');
		var progressBar = document.getElementById('mp-progress-bar');
		var trackBtns = Array.prototype.slice.call(root.querySelectorAll('.mp-track'));

		var LS_KEY = 'music-player-state';
		var state = { track: 0, volume: 0.4, playing: false, open: false };
		try {
			var saved = JSON.parse(localStorage.getItem(LS_KEY) || '{}');
			if (typeof saved.track === 'number' && saved.track >= 0 && saved.track < trackBtns.length) state.track = saved.track;
			if (typeof saved.volume === 'number') state.volume = Math.min(1, Math.max(0, saved.volume));
			if (saved.playing === true) state.playing = true;
			if (saved.open === true) state.open = true;
		} catch (e) {}

		function saveState() {
			try { localStorage.setItem(LS_KEY, JSON.stringify(state)); } catch (e) {}
		}

		function currentBtn() { return trackBtns[state.track]; }

		function loadTrack(autoplay) {
			var btn = currentBtn();
			if (!btn) return;
			audio.src = btn.getAttribute('data-src');
			titleEl.textContent = btn.getAttribute('data-title');
			artistEl.textContent = btn.getAttribute('data-artist');
			trackBtns.forEach(function (b) { b.classList.toggle('active', b === btn); });
			if (autoplay) {
				play();
			} else {
				updatePlayIcon();
			}
		}

		function updatePlayIcon() {
			var playing = !audio.paused && !audio.ended;
			iconPlay.style.display = playing ? 'none' : '';
			iconPause.style.display = playing ? '' : 'none';
			root.classList.toggle('playing', playing);
		}

		function play() {
			audio.play().then(function () {
				state.playing = true;
				saveState();
				updatePlayIcon();
			}).catch(function () {
				// 浏览器阻止自动播放：保持暂停状态
				state.playing = false;
				saveState();
				updatePlayIcon();
			});
		}

		function pause() {
			audio.pause();
			state.playing = false;
			saveState();
			updatePlayIcon();
		}

		function switchTrack(delta) {
			state.track = (state.track + delta + trackBtns.length) % trackBtns.length;
			saveState();
			loadTrack(true);
		}

		// 展开 / 收起
		function setOpen(open) {
			state.open = open;
			saveState();
			root.classList.toggle('collapsed', !open);
		}
		fab.addEventListener('click', function () { setOpen(true); });
		collapseBtn.addEventListener('click', function () { setOpen(false); });

		playBtn.addEventListener('click', function () {
			if (audio.paused) {
				if (!audio.src) { loadTrack(true); } else { play(); }
			} else {
				pause();
			}
		});
		prevBtn.addEventListener('click', function () { switchTrack(-1); });
		nextBtn.addEventListener('click', function () { switchTrack(1); });

		trackBtns.forEach(function (btn) {
			btn.addEventListener('click', function () {
				state.track = parseInt(btn.getAttribute('data-index'), 10) || 0;
				saveState();
				loadTrack(true);
			});
		});

		volumeInput.addEventListener('input', function () {
			state.volume = volumeInput.value / 100;
			audio.volume = state.volume;
			saveState();
		});

		audio.addEventListener('ended', function () { switchTrack(1); });
		audio.addEventListener('timeupdate', function () {
			if (audio.duration) {
				progressBar.style.width = (audio.currentTime / audio.duration) * 100 + '%';
			}
		});
		progress.addEventListener('click', function (e) {
			if (!audio.duration) return;
			var rect = progress.getBoundingClientRect();
			audio.currentTime = ((e.clientX - rect.left) / rect.width) * audio.duration;
		});

		// 初始化
		audio.volume = state.volume;
		volumeInput.value = Math.round(state.volume * 100);
		root.classList.toggle('collapsed', !state.open);
		loadTrack(false);
		// 页面跳转后尝试续播（浏览器可能阻止，失败则保持暂停）
		if (state.playing) { play(); }
	});
</script>

<style>
	#music-player {
		position: fixed;
		bottom: 2em;
		left: 2em;
		z-index: 99;
		font-size: 14px;
	}
	#mp-fab {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: var(--bg-elevated);
		color: var(--accent);
		border: 1px solid var(--border);
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: var(--shadow-sm);
		transition: border-color 0.2s, box-shadow 0.2s, color 0.15s;
	}
	#mp-fab:hover {
		border-color: var(--accent);
		box-shadow: var(--shadow-md);
	}
	#music-player.playing #mp-fab {
		color: #fff;
		background: var(--accent);
		border-color: var(--accent);
		animation: mp-pulse 2s ease-in-out infinite;
	}
	@keyframes mp-pulse {
		0%, 100% { box-shadow: 0 0 0 0 rgba(79, 70, 229, 0.35); }
		50% { box-shadow: 0 0 0 8px rgba(79, 70, 229, 0); }
	}
	#music-player.collapsed #mp-panel {
		display: none;
	}
	#music-player:not(.collapsed) #mp-fab {
		display: none;
	}
	#mp-panel {
		width: 250px;
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-lg);
		padding: 0.9em 1em 0.7em;
	}
	.mp-top {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.5em;
	}
	.mp-title {
		font-weight: 700;
		color: var(--text);
		font-size: 0.95em;
		line-height: 1.3;
	}
	.mp-artist {
		color: var(--text-secondary);
		font-size: 0.78em;
		margin-top: 0.2em;
	}
	#mp-collapse {
		background: none;
		border: none;
		color: var(--text-secondary);
		cursor: pointer;
		padding: 2px;
		border-radius: var(--radius-sm);
		flex-shrink: 0;
	}
	#mp-collapse:hover { color: var(--accent); }
	.mp-progress {
		height: 4px;
		background: var(--border);
		border-radius: 999px;
		margin: 0.7em 0;
		cursor: pointer;
		overflow: hidden;
	}
	.mp-progress-bar {
		height: 100%;
		width: 0;
		background: var(--accent);
		border-radius: 999px;
		transition: width 0.2s linear;
	}
	.mp-controls {
		display: flex;
		align-items: center;
		gap: 0.5em;
	}
	.mp-controls button {
		background: none;
		border: none;
		color: var(--text);
		cursor: pointer;
		padding: 4px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: color 0.15s;
	}
	.mp-controls button:hover { color: var(--accent); }
	.mp-play-btn {
		width: 38px;
		height: 38px;
		background: var(--accent) !important;
		color: #fff !important;
		transition: background 0.15s;
	}
	.mp-play-btn:hover { background: var(--accent-dark) !important; }
	#mp-volume {
		flex: 1;
		min-width: 0;
		accent-color: var(--accent);
		height: 3px;
		cursor: pointer;
	}
	.mp-tracks {
		display: flex;
		flex-direction: column;
		gap: 0.25em;
		margin-top: 0.7em;
		border-top: 1px solid var(--border);
		padding-top: 0.6em;
	}
	.mp-track {
		display: flex;
		align-items: center;
		gap: 0.5em;
		background: none;
		border: none;
		border-radius: var(--radius-sm);
		padding: 0.35em 0.5em;
		cursor: pointer;
		text-align: left;
		color: var(--text);
		font-size: 0.85em;
		transition: background 0.15s, color 0.15s;
	}
	.mp-track:hover { background: var(--accent-soft); }
	.mp-track.active { background: var(--accent-soft); color: var(--accent); }
	.mp-track-genre {
		font-size: 0.75em;
		padding: 0.1em 0.5em;
		border-radius: 999px;
		background: var(--bg);
		border: 1px solid var(--border);
		color: var(--text-secondary);
		flex-shrink: 0;
	}
	.mp-track.active .mp-track-genre {
		background: var(--accent);
		border-color: var(--accent);
		color: #fff;
	}
	.mp-track-name {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.mp-credit {
		margin-top: 0.6em;
		font-size: 0.7em;
		color: var(--text-secondary);
		text-align: center;
	}
	.mp-credit a {
		color: var(--text-secondary);
		text-decoration: underline;
	}
	.mp-credit a:hover { color: var(--accent); }
	@media (max-width: 720px) {
		#music-player {
			bottom: 1em;
			left: 1em;
		}
		#mp-panel {
			width: 220px;
		}
	}
</style>
