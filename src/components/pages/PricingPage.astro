---

<BaseLayout title={t.title} description={t.description} lang={lang}>
	<style>
		main {
			width: var(--wide-width);
			max-width: calc(100% - 2em);
			margin: auto;
			padding: 2em 1em 4em;
		}
		.hero {
			padding: 1em 0 1.5em;
		}
		.hero h1 {
			font-size: 1.5em;
			margin: 0 0 0.3em;
		}
		.hero p {
			color: var(--text-secondary);
			font-size: 0.95em;
			max-width: 560px;
			margin: 0;
			line-height: 1.7;
		}

		.plans {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
			gap: 1.2em;
			margin: 2em 0;
			align-items: start;
		}
		.plan-card {
			background: var(--bg-elevated);
			border: 1px solid var(--border);
			border-radius: var(--radius-lg);
			padding: 1.6em;
			display: flex;
			flex-direction: column;
			position: relative;
			transition: border-color 0.2s, box-shadow 0.2s;
		}
		.plan-card:hover {
			border-color: var(--accent);
		}
		.plan-card.highlight {
			border-color: var(--accent);
			box-shadow: 0 0 0 3px var(--accent-soft);
		}
		.badge {
			position: absolute;
			top: -0.7em;
			right: 1em;
			background: var(--accent);
			color: white;
			font-size: 0.75em;
			font-weight: 700;
			padding: 0.3em 0.8em;
			border-radius: 999px;
		}
		.plan-card h2 {
			margin: 0 0 0.2em;
			font-size: 1.25em;
		}
		.plan-price {
			font-size: 1.7em;
			font-weight: 800;
			color: var(--accent);
			margin: 0.2em 0 0.6em;
		}
		.plan-price span {
			font-size: 0.5em;
			color: var(--text-secondary);
			font-weight: 500;
		}
		.plan-desc {
			color: var(--text-secondary);
			font-size: 0.92em;
			line-height: 1.6;
			margin-bottom: 1em;
		}
		.plan-features {
			list-style: none;
			padding: 0;
			margin: 0 0 1.5em;
			flex: 1;
		}
		.plan-features li {
			padding: 0.4em 0 0.4em 1.4em;
			position: relative;
			font-size: 0.9em;
		}
		.plan-features li::before {
			content: '✓';
			position: absolute;
			left: 0;
			color: var(--accent);
			font-weight: 700;
		}
		.plan-cta {
			display: block;
			text-align: center;
			padding: 0.65em 1em;
			border-radius: var(--radius-md);
			font-weight: 600;
			font-size: 0.92em;
			text-decoration: none;
			border: 1px solid transparent;
			transition: background 0.15s, border-color 0.2s, color 0.15s;
		}
		.plan-cta.primary {
			background: var(--accent);
			color: white;
		}
		.plan-cta.primary:hover {
			background: var(--accent-dark);
			color: white;
		}
		.plan-cta.secondary {
			background: transparent;
			color: var(--text);
			border-color: var(--border);
		}
		.plan-cta.secondary:hover {
			border-color: var(--accent);
			color: var(--accent);
		}

		.compare-section {
			margin: 3em 0;
		}
		.section-title {
			font-size: 1.4em;
			margin-bottom: 1em;
			padding-bottom: 0.4em;
			border-bottom: 1px solid var(--border);
		}
		.compare-table {
			width: 100%;
			border-collapse: collapse;
			font-size: 0.92em;
		}
		.compare-table th,
		.compare-table td {
			padding: 0.7em 0.8em;
			border-bottom: 1px solid var(--border);
			text-align: left;
		}
		.compare-table th {
			color: var(--text-secondary);
			font-weight: 600;
		}
		.compare-table td:nth-child(n+2) {
			text-align: center;
		}

		.faq-section {
			margin: 3em 0 2em;
		}
		.faq-item {
			background: var(--bg-elevated);
			border-radius: var(--radius-md);
			border: 1px solid var(--border);
			margin-bottom: 0.8em;
			overflow: hidden;
		}
		.faq-q {
			padding: 1em 1.2em;
			font-weight: 600;
			cursor: pointer;
			display: flex;
			justify-content: space-between;
			align-items: center;
			transition: background 0.15s;
		}
		.faq-q:hover {
			background: var(--accent-soft);
		}
		.faq-arrow {
			font-size: 0.8em;
			color: var(--text-secondary);
			transition: transform 0.2s;
		}
		.faq-item.open .faq-arrow {
			transform: rotate(180deg);
		}
		.faq-a {
			max-height: 0;
			overflow: hidden;
			transition: max-height 0.3s ease;
		}
		.faq-item.open .faq-a {
			max-height: 300px;
		}
		.faq-a-inner {
			padding: 0 1.2em 1em;
			color: var(--text-secondary);
			line-height: 1.7;
			font-size: 0.95em;
		}
		@media (max-width: 720px) {
			.compare-table { font-size: 0.85em; }
		}
	</style>

	<main>
		<section class="hero">
			<h1>{t.heroTitle}</h1>
			<p>{t.heroDesc}</p>
		</section>

		<section class="plans">
			{t.plans.map((plan) => (
				<div class={`plan-card ${plan.highlight ? 'highlight' : ''}`}>
					{plan.highlight && <span class="badge">{t.badge}</span>}
					<h2>{plan.name}</h2>
					<div class="plan-price">{plan.price}<span> / {plan.period}</span></div>
					<p class="plan-desc">{plan.desc}</p>
					<ul class="plan-features">
						{plan.features.map((f) => <li>{f}</li>)}
					</ul>
					<a
						href={plan.ctaHref}
						class={`plan-cta ${plan.highlight ? 'primary' : 'secondary'}`}
						target={plan.ctaExternal ? '_blank' : undefined}
						rel={plan.ctaExternal ? 'noopener' : undefined}
					>
						{plan.cta}
					</a>
				</div>
			))}
		</section>

		<section class="compare-section">
			<h2 class="section-title">{t.compareTitle}</h2>
			<table class="compare-table">
				<thead>
					<tr>
						{t.compareHeaders.map((h) => <th>{h}</th>)}
					</tr>
				</thead>
				<tbody>
					{t.compareRows.map((row) => (
						<tr>
							{row.map((cell) => <td>{cell}</td>)}
						</tr>
					))}
				</tbody>
			</table>
		</section>

		<section class="faq-section">
			<h2 class="section-title">{t.faqTitle}</h2>
			{t.faqs.map((f, i) => (
				<div class="faq-item" data-faq={i}>
					<div class="faq-q">
						{f.q}
						<span class="faq-arrow">▼</span>
					</div>
					<div class="faq-a">
						<div class="faq-a-inner">{f.a}</div>
					</div>
				</div>
			))}
		</section>
	</main>

	<script is:inline>
		document.addEventListener('DOMContentLoaded', function() {
			document.querySelectorAll('.faq-item').forEach(function(item) {
				var q = item.querySelector('.faq-q');
				q.addEventListener('click', function() {
					item.classList.toggle('open');
				});
			});
		});
	</script>

	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
