const t = dicts[lang];
---

<BaseLayout title={t.title} description={t.description} lang={lang}>
		<style>
			main {
				width: var(--content-width);
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2.5em 1em;
			}
			.hero {
				padding: 1em 0 1.5em;
			}
			.hero h1 {
				font-size: 1.5em;
				margin: 0 0 0.3em;
			}
			.hero p {
				color: var(--text-secondary);
				font-size: 0.95em;
				margin: 0;
			}

			/* Contact cards */
			.contact-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
				gap: 1em;
				margin: 2em 0;
			}
			.contact-card {
				background: var(--bg-elevated);
				border-radius: var(--radius-lg);
				padding: 1.3em 1.4em;
				border: 1px solid var(--border);
				text-decoration: none;
				color: inherit;
				transition: border-color 0.2s, box-shadow 0.2s;
				display: flex;
				align-items: flex-start;
				gap: 1em;
			}
			.contact-card:hover {
				border-color: var(--accent);
				box-shadow: var(--shadow-md);
			}
			.contact-icon {
				width: 40px;
				height: 40px;
				background: var(--accent-soft);
				border-radius: var(--radius-md);
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 1.2em;
				flex-shrink: 0;
			}
			.contact-info h3 {
				margin: 0 0 0.2em;
				font-size: 1.05em;
			}
			.contact-info p {
				margin: 0 0 0.4em;
				font-size: 0.85em;
				color: var(--text-secondary);
				line-height: 1.4;
			}
			.contact-value {
				font-size: 0.9em;
				color: var(--accent);
				font-weight: 600;
				word-break: break-all;
			}

			/* Wechat modal */
			.modal-overlay {
				position: fixed;
				top: 0; left: 0;
				width: 100%; height: 100%;
				background: rgba(0,0,0,0.5);
				z-index: 2000;
				display: flex;
				align-items: center;
				justify-content: center;
				opacity: 0;
				transition: opacity 0.2s;
				pointer-events: none;
			}
			.modal-overlay.active {
				opacity: 1;
				pointer-events: auto;
			}
			.modal-box {
				background: var(--bg-elevated);
				border: 1px solid var(--border);
				border-radius: var(--radius-lg);
				padding: 2em;
				text-align: center;
				max-width: 320px;
				width: 90%;
				transform: translateY(20px);
				transition: transform 0.2s;
			}
			.modal-overlay.active .modal-box {
				transform: translateY(0);
			}
			.modal-box h3 {
				margin: 0 0 0.5em;
			}
			.modal-box p {
				color: var(--text-secondary);
				font-size: 0.9em;
			}
			.modal-box .wechat-id {
				font-size: 1.3em;
				font-weight: 700;
				color: var(--accent);
				margin: 0.5em 0;
				user-select: all;
			}
			.modal-close {
				margin-top: 1em;
				padding: 0.55em 1.4em;
				background: transparent;
				border: 1px solid var(--border);
				border-radius: var(--radius-md);
				cursor: pointer;
				font-size: 0.9em;
				color: var(--text);
				transition: border-color 0.2s, color 0.15s;
			}
			.modal-close:hover {
				border-color: var(--accent);
				color: var(--accent);
			}

			/* Form section */
			.form-section {
				background: var(--bg-elevated);
				border-radius: var(--radius-lg);
				padding: 1.8em;
				border: 1px solid var(--border);
				margin: 2em 0;
			}
			.form-section h2 {
				margin: 0 0 1em;
				font-size: 1.2em;
			}
			.form-row {
				margin-bottom: 1em;
			}
			.form-row label {
				display: block;
				font-size: 0.9em;
				color: var(--text);
				margin-bottom: 0.3em;
				font-weight: 500;
			}
			.form-row input,
			.form-row textarea,
			.form-row select {
				width: 100%;
				padding: 0.6em 0.8em;
				border: 1px solid var(--border);
				border-radius: var(--radius-md);
				font-size: 1em;
				font-family: inherit;
				background: var(--bg);
				color: var(--text);
				box-sizing: border-box;
				transition: border-color 0.2s;
			}
			.form-row input:focus,
			.form-row textarea:focus,
			.form-row select:focus {
				outline: none;
				border-color: var(--accent);
			}
			.form-row textarea {
				resize: vertical;
				min-height: 120px;
			}
			.submit-btn {
				display: inline-block;
				padding: 0.65em 1.6em;
				background: var(--accent);
				color: white;
				border: none;
				border-radius: var(--radius-md);
				font-size: 0.95em;
				font-weight: 600;
				cursor: pointer;
				transition: background 0.15s;
			}
			.submit-btn:hover {
				background: var(--accent-dark);
			}

			.note {
				color: var(--text-secondary);
				font-size: 0.85em;
				margin-top: 1em;
			}

			@media (max-width: 720px) {
				.contact-grid { grid-template-columns: 1fr; }
			}
		</style>
	<main>
			<section class="hero">
				<h1>{t.heroTitle}</h1>
				<p>{t.heroDesc}</p>
			</section>

			<section class="contact-grid">
				{t.channels.map((c) => (
					<a href={c.href} class="contact-card" target={c.href.startsWith('http') ? '_blank' : undefined} rel={c.href.startsWith('http') ? 'noopener' : undefined} data-channel={c.href === '#wechat' ? 'wechat' : c.title}>
						<div class="contact-icon">{c.icon}</div>
						<div class="contact-info">
							<h3>{c.title}</h3>
							<p>{c.desc}</p>
							<div class="contact-value">{c.value}</div>
						</div>
					</a>
				))}
			</section>

			<section class="form-section">
				<h2>{t.formTitle}</h2>
				<form action="https://formspree.io/f/xoqgvjvq" method="POST">
					<div class="form-row">
						<label for="name">{t.labelName}</label>
						<input type="text" id="name" name="name" placeholder={t.placeholderName} required />
					</div>
					<div class="form-row">
						<label for="email">{t.labelEmail}</label>
						<input type="email" id="email" name="email" placeholder="your@email.com" required />
					</div>
					<div class="form-row">
						<label for="service">{t.labelService}</label>
						<select id="service" name="service">
							{t.serviceOptions.map((o) => (
								<option value={o.value}>{o.text}</option>
							))}
						</select>
					</div>
					<div class="form-row">
						<label for="message">{t.labelMessage}</label>
						<textarea id="message" name="message" placeholder={t.placeholderMessage} required></textarea>
					</div>
					<button type="submit" class="submit-btn">{t.submitBtn}</button>
					<p class="note">{t.formNote}</p>
				</form>
			</section>
		</main>
<!-- WeChat Modal -->
		<div class="modal-overlay" id="wechat-modal">
			<div class="modal-box">
				<h3>{t.modalTitle}</h3>
				<p>{t.modalDesc}</p>
				<div class="wechat-id">ll1186607113</div>
				<button class="modal-close" id="modal-close">{t.modalClose}</button>
			</div>
		</div>

		<script is:inline>
			document.addEventListener('DOMContentLoaded', function() {
				document.querySelectorAll('.contact-card').forEach(function(card) {
					card.addEventListener('click', function(e) {
						if (card.dataset.channel === 'wechat') {
							e.preventDefault();
							document.getElementById('wechat-modal').classList.add('active');
						}
					});
				});
				document.getElementById('modal-close').addEventListener('click', function() {
					document.getElementById('wechat-modal').classList.remove('active');
				});
				document.getElementById('wechat-modal').addEventListener('click', function(e) {
					if (e.target === this) this.classList.remove('active');
				});
			});
		</script>
</BaseLayout>
