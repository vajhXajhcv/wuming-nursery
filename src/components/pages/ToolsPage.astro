			},
			{
				name: '論文執筆 文字数カウンター',
				tagline: '中国語・英語混在のリアルタイム集計',
				description: '中国語文字数と英単語数を分けて集計。段落数・文数・句読点比率・予想読了時間・目標字数の進捗バー付き。（中国語 UI）',
				href: '/tools/word-count',
				tags: ['論文執筆', '統計'],
				status: '公開済み',
			},
			{
				name: '論文書式セルフチェックリスト',
				tagline: '提出前に項目ごとに確認',
				description: 'ページ設定・フォント・見出し番号・図表と数式・参考文献・出力の 6 分類 30 項目をチェック。進捗は自動保存され、レポートをエクスポート可能。（中国語 UI）',
				href: '/tools/thesis-checklist',
				tags: ['論文執筆', 'チェックリスト'],
				status: '公開済み',
