---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../consts';
import { DEFAULT_LOCALE, type Locale } from '../../i18n/config';

interface Props {
	lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;

const dicts = {
	zh: {
		title: `产品工具 - ${SITE_TITLE}`,
		description: '无名苗圃的产品与工具：docx-formatter-cn 中文论文排版、在线 Markdown 转 Word，以及更多实验性项目。',
		heroTitle: '产品与工具',
		heroDesc: '把重复劳动交给代码，把时间留给创造。这里是我正在构建和销售的工具产品。',
		flagship: {
			name: 'docx-formatter-cn',
			tagline: '中文 Word 文档智能排版工具',
			description: '把 Markdown 一键转成符合中文学术规范的 Word 文档。支持毕业论文、课程论文、数学建模、公文模板，以及 arXiv / Nature / Science / IEEE / APA 等期刊/预印本近似格式；LaTeX 公式原生转换、三线表、自动编号。',
			links: [
				{ text: '🚀 在线免费试用', href: '/tools/md2docx', primary: true },
				{ text: '📖 阅读文档', href: '/projects/docx-formatter-docs', primary: false },
				{ text: '💰 查看定价', href: '/pricing', primary: false },
			],
			features: ['Markdown → Word 一键转换', 'LaTeX 公式转原生 OMML', '三线表与自动编号', '中文学位论文 + 国际期刊模板', 'CLI / GUI / Python API / 在线工具'],
			tags: ['Python', 'Markdown', 'LaTeX', 'Word', '已发布'],
		},
		tools: [
			{
				name: '在线 Markdown 转 Word',
				tagline: '浏览器内直接转换，无需安装',
				description: '基于 Pyodide 在浏览器本地运行，文档内容不上传服务器。适合快速体验和轻量文档。',
