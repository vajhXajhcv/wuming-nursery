		ctaDesc: 'ツールの利用に加えて、テンプレートのカスタマイズ、一括変換の統合、論文整形サービスも提供しています。',
		ctaBtn: 'サービスを見る →',
		jsonLdName: `プロダクト・ツール - ${SITE_TITLE}`,
		jsonLdDesc: 'プロダクトとツール一覧。目玉は docx-formatter-cn 中国語論文整形ツール。',
	},
} as const;

const t = dicts[lang];

const jsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: t.jsonLdName,
	description: t.jsonLdDesc,
});
---

<BaseLayout title={t.title} description={t.description} lang={lang}>
	<style>
		main {
			width: 960px;
			max-width: calc(100% - 2em);
			margin: auto;
			padding: 2em 1em 4em;
		}
		.hero {
			padding: 1em 0 0.5em;
		}
		.hero h1 {
			font-size: 1.45em;
			margin: 0 0 0.3em;
		}
		.hero p {
			color: var(--text-secondary);
			font-size: 0.95em;
			max-width: 620px;
			margin: 0;
			line-height: 1.7;
		}

		.flagship {
			padding: 1.8em;
			margin: 1.8em 0;
		}
		.flagship-header {
			display: flex;
			align-items: flex-start;
			gap: 1em;
			margin-bottom: 1em;
		}
		.flagship-icon {
			width: 52px;
			height: 52px;
			background: var(--accent-soft);
			border-radius: var(--radius-md);
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 1.5em;
			flex-shrink: 0;
		}
		.flagship-title h2 {
			margin: 0 0 0.2em;
			font-size: 1.25em;
		}
		.flagship-title .tagline {
			color: var(--text-secondary);
			font-size: 0.92em;
			margin: 0;
		}
		.flagship-desc {
			line-height: 1.8;
			margin-bottom: 1.2em;
			font-size: 0.95em;
		}
		.flagship-features {
			list-style: none;
			padding: 0;
			margin: 0 0 1.5em;
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
			gap: 0.5em;
		}
		.flagship-features li {
			font-size: 0.88em;
			color: var(--text-secondary);
			padding-left: 1.4em;
			position: relative;
		}
		.flagship-features li::before {
			content: '✓';
			position: absolute;
			left: 0;
			color: var(--accent);
			font-weight: 700;
		}
		.flagship-actions {
			display: flex;
			flex-wrap: wrap;
			gap: 0.7em;
			margin-top: 1em;
		}
		.flagship-tags {
			display: flex;
			flex-wrap: wrap;
			gap: 0.4em;
			margin-top: 1.2em;
		}

		.section-title {
			font-size: 1.25em;
			margin: 2.5em 0 1em;
			padding-bottom: 0.4em;
			border-bottom: 1px solid var(--border);
		}

		.tool-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
			gap: 1em;
		}
		.tool-card {
			padding: 1.4em;
			text-decoration: none;
			color: inherit;
			transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
			display: flex;
			flex-direction: column;
		}
		.tool-card:hover {
			border-color: var(--accent);
			box-shadow: var(--shadow-md);
			transform: translateY(-2px);
		}
		.tool-card h3 {
			margin: 0 0 0.2em;
			font-size: 1.05em;
		}
		.tool-card .tagline {
			font-size: 0.85em;
			color: var(--text-secondary);
			margin-bottom: 0.8em;
		}
		.tool-card .desc {
			font-size: 0.88em;
			color: var(--text-secondary);
			line-height: 1.6;
			flex: 1;
			margin-bottom: 1em;
		}
		.tool-card .status {
			font-weight: 500;
			margin-bottom: 0.8em;
			align-self: flex-start;
		}
		.tool-card .tags {
			display: flex;
			flex-wrap: wrap;
			gap: 0.4em;
		}
		.tool-card .tags span {
			font-size: 0.75em;
			padding: 0.15em 0.6em;
			border-radius: var(--radius-sm);
			border: 1px solid var(--border);
			color: var(--text-secondary);
		}

		.cta-box {
			background: var(--bg-elevated);
			border-radius: var(--radius-lg);
			padding: 1.8em;
			text-align: center;
			border: 1px solid var(--border);
			margin-top: 2.5em;
		}
		.cta-box h2 {
			margin: 0 0 0.4em;
			font-size: 1.2em;
		}
		.cta-box p {
			color: var(--text-secondary);
			margin: 0 0 1.2em;
			font-size: 0.92em;
		}

		@media (max-width: 720px) {
			.flagship-header { flex-direction: column; gap: 0.8em; }
			.flagship-actions { flex-direction: column; }
			.btn { width: 100%; justify-content: center; min-height: 40px; box-sizing: border-box; }
		}
	</style>

	<main>
		<section class="hero">
			<h1>{t.heroTitle}</h1>
			<p>{t.heroDesc}</p>
		</section>

		<section class="card flagship">
			<div class="flagship-header">
				<div class="flagship-icon">📄</div>
				<div class="flagship-title">
					<h2>{t.flagship.name}</h2>
					<p class="tagline">{t.flagship.tagline}</p>
				</div>
			</div>
			<p class="flagship-desc">{t.flagship.description}</p>
			<ul class="flagship-features">
				{t.flagship.features.map((f) => <li>{f}</li>)}
			</ul>
			<div class="flagship-actions">
				{t.flagship.links.map((link) => (
					<a href={link.href} class={`btn ${link.primary ? 'btn-primary' : 'btn-outline'}`}>{link.text}</a>
				))}
			</div>
			<div class="flagship-tags">
				{t.flagship.tags.map((tag) => <span class="badge">{tag}</span>)}
			</div>
		</section>

		<h2 class="section-title">{t.sectionTitle}</h2>
		<div class="tool-grid">
			{t.tools.map((tool) => (
				<a href={tool.href} class="card tool-card">
					<span class="badge status">{tool.status}</span>
					<h3>{tool.name}</h3>
					<p class="tagline">{tool.tagline}</p>
					<p class="desc">{tool.description}</p>
					<div class="tags">
						{tool.tags.map((tag) => <span>{tag}</span>)}
					</div>
				</a>
			))}
		</div>

		<section class="cta-box">
			<h2>{t.ctaTitle}</h2>
			<p>{t.ctaDesc}</p>
			<a href={lang === 'zh' ? '/services' : `/${lang}/services/`} class="btn btn-primary">{t.ctaBtn}</a>
		</section>
	</main>

	<script type="application/ld+json" is:inline set:html={jsonLd} />
</BaseLayout>
