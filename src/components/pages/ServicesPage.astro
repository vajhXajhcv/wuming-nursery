const t = dicts[lang];

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Product',
	name: t.jsonLd.name,
	description: t.jsonLd.description,
	offers: [
		{
			'@type': 'Offer',
			name: t.jsonLd.offerFreeName,
			price: '0',
			priceCurrency: 'CNY',
		},
		{
			'@type': 'Offer',
			name: t.jsonLd.offerProName,
			price: '49',
			priceCurrency: 'CNY',
		},
	],
};
---

<BaseLayout title={t.title} description={t.description} lang={lang}>
	<style>
		main {
			width: var(--wide-width);
			max-width: calc(100% - 2em);
			margin: auto;
			padding: 2em 1em;
		}
		.hero {
			padding: 1em 0 1.5em;
		}
		.hero h1 {
			font-size: 1.5em;
			margin: 0 0 0.3em;
		}
		.hero p {
			color: var(--text-secondary);
			font-size: 0.95em;
			max-width: 600px;
			margin: 0;
			line-height: 1.7;
		}

		/* Service cards */
		.service-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
			gap: 1.2em;
			margin: 2em 0;
		}
		.service-card {
			padding: 1.6em;
			transition: border-color 0.2s, box-shadow 0.2s;
			display: flex;
			flex-direction: column;
		}
		.service-card:hover {
			border-color: var(--accent);
			box-shadow: var(--shadow-md);
		}
		.service-card .icon {
			width: 44px;
			height: 44px;
			background: var(--accent-soft);
			border-radius: var(--radius-md);
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 1.35em;
			margin-bottom: 1em;
		}
		.service-card h3 {
			margin: 0 0 0.2em;
			font-size: 1.15em;
		}
		.service-card .subtitle {
			font-size: 0.85em;
			color: var(--text-secondary);
			margin-bottom: 0.8em;
		}
		.service-card .desc {
			font-size: 0.92em;
			line-height: 1.7;
			margin-bottom: 1em;
			flex: 1;
		}
		.service-card .features {
			list-style: none;
			padding: 0;
			margin: 0 0 1em;
		}
		.service-card .features li {
			font-size: 0.85em;
			color: var(--text-secondary);
			padding: 0.25em 0;
			padding-left: 1.2em;
			position: relative;
		}
		.service-card .features li::before {
			content: '✓';
			position: absolute;
			left: 0;
			color: var(--accent);
			font-weight: 700;
		}
		.service-card .price {
			font-size: 1.05em;
			font-weight: 700;
			color: var(--accent);
			margin-top: auto;
		}
		.service-links {
			display: flex;
			flex-wrap: wrap;
			gap: 0.6em;
			margin-top: 0.8em;
		}
		.service-links a {
			font-size: 0.85em;
			color: var(--accent);
			text-decoration: none;
			padding: 0.35em 0.7em;
			border: 1px solid var(--border);
			border-radius: var(--radius-sm);
			transition: border-color 0.2s, color 0.15s;
		}
		.service-links a:hover {
			border-color: var(--accent);
			color: var(--accent-dark);
		}

		/* Pricing */
		.pricing-section {
			margin: 3em 0;
			scroll-margin-top: 4.5em;
		}
		.pricing-desc {
			color: var(--text-secondary);
			font-size: 0.95em;
			max-width: 560px;
			margin: 0 0 1.5em;
			line-height: 1.7;
		}
		.plans {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
			gap: 1.2em;
			margin: 2em 0;
			align-items: start;
		}
		.plan-card {
			padding: 1.6em;
			display: flex;
			flex-direction: column;
			position: relative;
			transition: border-color 0.2s, box-shadow 0.2s;
		}
		.plan-card:hover {
			border-color: var(--accent);
		}
		.plan-card.highlight {
			border-color: var(--accent);
			box-shadow: 0 0 0 3px var(--accent-soft);
		}
		.plan-badge {
			position: absolute;
			top: -0.7em;
			right: 1em;
			background: var(--accent);
			color: #fff;
			font-size: var(--text-xs);
			font-weight: 700;
			padding: 0.3em 0.8em;
			border-radius: 999px;
		}
		.plan-card h3 {
			margin: 0 0 0.2em;
			font-size: 1.25em;
		}
		.plan-price {
			font-size: 1.7em;
			font-weight: 800;
			color: var(--accent);
			margin: 0.2em 0 0.6em;
		}
		.plan-price span {
			font-size: 0.5em;
			color: var(--text-secondary);
			font-weight: 500;
		}
		.plan-desc {
			color: var(--text-secondary);
			font-size: 0.92em;
			line-height: 1.6;
			margin-bottom: 1em;
		}
		.plan-features {
			list-style: none;
			padding: 0;
			margin: 0 0 1.5em;
			flex: 1;
		}
		.plan-features li {
			padding: 0.4em 0 0.4em 1.4em;
			position: relative;
			font-size: 0.9em;
		}
		.plan-features li::before {
			content: '✓';
			position: absolute;
			left: 0;
			color: var(--accent);
			font-weight: 700;
		}
		.plan-cta {
			width: 100%;
			box-sizing: border-box;
		}
		.plan-note {
			font-size: 0.78em;
			color: var(--text-secondary);
			text-align: center;
			margin: 0.6em 0 0;
		}
		.trust-bar {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5em 1.4em;
			margin: 1.6em 0 0;
			font-size: 0.85em;
			color: var(--text-secondary);
		}
		.trust-item {
			color: var(--text-secondary);
			text-decoration: none;
		}
		a.trust-item:hover {
			color: var(--accent);
		}
		.free-tools {
			font-size: 0.85em;
			color: var(--text-secondary);
			margin: 0.8em 0 0;
		}
		.free-tools a {
			color: var(--accent);
			text-decoration: none;
		}

		/* Compare */
		.compare-section {
			margin: 2em 0 0;
		}
		.compare-subtitle {
			font-size: 1.1em;
			margin: 0 0 0.8em;
		}
		.compare-table td:nth-child(n+2) {
			text-align: center;
		}

		/* Process */
		.process-section {
			margin: 3em 0;
		}
		.section-title {
			font-size: 1.4em;
			margin-bottom: 1em;
			padding-bottom: 0.4em;
			border-bottom: 1px solid var(--border);
		}
		.process-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
			gap: 1.2em;
		}
		.process-card {
			padding: 1.4em 1.2em;
			border-radius: var(--radius-md);
		}
		.process-card .step {
			font-size: 1.6em;
			font-weight: 800;
			color: var(--accent);
			opacity: 0.35;
			line-height: 1;
			margin-bottom: 0.3em;
		}
		.process-card h4 {
			margin: 0 0 0.4em;
			font-size: 1.05em;
		}
		.process-card p {
			margin: 0;
			font-size: 0.88em;
			color: var(--text-secondary);
			line-height: 1.6;
		}

		/* FAQ */
		.faq-section {
			margin: 3em 0;
		}
		.faq-item {
			background: var(--bg-elevated);
			border-radius: var(--radius-md);
			border: 1px solid var(--border);
			margin-bottom: 0.8em;
			overflow: hidden;
		}
		.faq-q {
			padding: 1em 1.2em;
			font-weight: 600;
			cursor: pointer;
			display: flex;
			justify-content: space-between;
			align-items: center;
			transition: background 0.15s;
		}
		.faq-q:hover {
			background: var(--accent-soft);
		}
		.faq-arrow {
			transition: transform 0.2s;
			font-size: 0.8em;
			color: var(--text-secondary);
		}
		.faq-item.open .faq-arrow {
			transform: rotate(180deg);
		}
		.faq-a {
			max-height: 0;
			overflow: hidden;
			transition: max-height 0.3s ease;
		}
		.faq-item.open .faq-a {
			max-height: 300px;
		}
		.faq-a-inner {
			padding: 0 1.2em 1em;
			color: var(--text-secondary);
			font-size: 0.95em;
			line-height: 1.7;
		}

		/* CTA */
		.cta-box {
			background: var(--accent-soft);
			border-radius: var(--radius-lg);
			padding: 2em;
			text-align: center;
			border: 1px solid var(--border);
			margin: 3em 0;
		}
		.cta-box h2 {
			margin: 0 0 0.3em;
			font-size: 1.3em;
		}
		.cta-box p {
			color: var(--text-secondary);
			font-size: 0.92em;
			margin: 0 0 1.2em;
		}

		@media (max-width: 720px) {
			.service-grid { grid-template-columns: 1fr; }
			.process-grid { grid-template-columns: 1fr 1fr; }
			.compare-table { font-size: 0.85em; }
		}
	</style>
	<main>
		<section class="hero">
			<h1>{t.heroTitle}</h1>
			<p>
				{t.heroDesc1}<br />
				{t.heroDesc2}
			</p>
		</section>

		<section class="service-grid">
			{t.services.map((s) => (
				<div class="card service-card">
					<div class="icon">{s.icon}</div>
					<h3>{s.title}</h3>
					<div class="subtitle">{s.subtitle}</div>
					<p class="desc">{s.desc}</p>
					<ul class="features">
						{s.features.map((f) => <li>{f}</li>)}
					</ul>
					<div class="price">{s.price}</div>
					{s.links.length > 0 && (
						<div class="service-links">
							{s.links.map((link) => (
								<a href={link.href}>{link.text}</a>
							))}
						</div>
					)}
				</div>
			))}
		</section>

		<section id="pricing" class="pricing-section">
			<h2 class="section-title">{t.pricingTitle}</h2>
			<p class="pricing-desc">{t.pricingDesc}</p>
			<div class="plans">
				{t.plans.map((plan) => (
					<div class={`card plan-card ${plan.highlight ? 'highlight' : ''}`}>
						{plan.highlight && <span class="plan-badge">{t.badge}</span>}
						<h3>{plan.name}</h3>
						<div class="plan-price">{plan.price}<span> / {plan.period}</span></div>
						<p class="plan-desc">{plan.desc}</p>
						<ul class="plan-features">
							{plan.features.map((f) => <li>{f}</li>)}
						</ul>
						<a
							href={plan.ctaHref}
							class={`btn plan-cta ${plan.highlight ? 'btn-primary' : 'btn-outline'}`}
							target={plan.ctaExternal ? '_blank' : undefined}
							rel={plan.ctaExternal ? 'noopener' : undefined}
						>
							{plan.cta}
						</a>
						{plan.highlight && <p class="plan-note">{t.proNote}</p>}
					</div>
				))}
			</div>
			<div class="compare-section">
				<h3 class="compare-subtitle">{t.compareTitle}</h3>
				<table class="table compare-table">
					<thead>
						<tr>
							{t.compareHeaders.map((h) => <th>{h}</th>)}
						</tr>
					</thead>
					<tbody>
						{t.compareRows.map((row) => (
							<tr>
								{row.map((cell) => <td>{cell}</td>)}
							</tr>
						))}
					</tbody>
				</table>
			</div>
			<div class="trust-bar">
				{t.trust.map((item) =>
					item.href ? (
						<a href={item.href} class="trust-item">✓ {item.text}</a>
					) : (
						<span class="trust-item">✓ {item.text}</span>
					),
				)}
			</div>
			<p class="free-tools">
				{t.freeToolsPrefix}
				{t.freeTools.map((l, i) => (
					<>
						{i > 0 && ' · '}
						<a href={l.href}>{l.text}</a>
					</>
				))}
			</p>
		</section>

		<section class="process-section">
			<h2 class="section-title">{t.processTitle}</h2>
			<div class="process-grid">
				{t.process.map((p) => (
					<div class="card process-card">
						<div class="step">{p.step}</div>
						<h4>{p.title}</h4>
						<p>{p.desc}</p>
					</div>
				))}
			</div>
		</section>

		<section class="faq-section">
			<h2 class="section-title">{t.faqTitle}</h2>
			{t.faqs.map((f, i) => (
				<div class="faq-item" data-faq={i}>
					<div class="faq-q">
						{f.q}
						<span class="faq-arrow">▼</span>
					</div>
					<div class="faq-a">
						<div class="faq-a-inner">{f.a}</div>
					</div>
				</div>
			))}
		</section>

		<section class="cta-box">
			<h2>{t.ctaTitle}</h2>
			<p>{t.ctaDesc}</p>
			<a href={lang === 'zh' ? '/contact' : `/${lang}/contact/`} class="btn btn-primary">{t.ctaBtn}</a>
		</section>
	</main>
	<script is:inline>
		document.addEventListener('DOMContentLoaded', function() {
			document.querySelectorAll('.faq-item').forEach(function(item) {
				var q = item.querySelector('.faq-q');
				q.addEventListener('click', function() {
					item.classList.toggle('open');
				});
			});
		});
	</script>

	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
