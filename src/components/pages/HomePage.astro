				link: 'See pricing →',
			},
			{
				href: '/en/services/thesis-formatting/',
				tag: 'Service',
				title: 'Thesis Formatting Service',
				desc: 'No time to wrestle with formatting? Send over your thesis and requirements — formatted to your university’s template, with two free revision rounds.',
				link: 'Learn more →',
			},
		],
		writingTitle: 'Latest Writing',
		writingArchiveText: 'Archive →',
		writingArchiveHref: '/archive',
		captionPosts: 'Writing',
		captionNotes: 'Notes',
		newsletterTitle: 'Subscribe for Updates',
		newsletterDesc: 'Occasional posts on indie development, AI tools, and the practice and pitfalls of running a one-person company.',
