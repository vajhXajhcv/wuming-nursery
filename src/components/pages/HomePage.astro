	ja: {
		title: SITE_TITLE,
		description: '個人開発者・テクニカルライター・一人会社の探求者。コード、コンテンツ、AI ツールで持続可能なクリエイタービジネスを構築。',
		avatarAlt: 'アバター',
		heroDesc: '個人開発者 · テクニカルライター · 一人会社の探求者',
		clockTitle: 'ローカル時間',
		clockPlaceholder: '----年--月--日 --:--:--',
		weekdays: ['日', '月', '火', '水', '木', '金', '土'],
		weekPre: '（',
		weekPost: '）',
		phrases: [
			'ゆっくりでいい、急がなくて。',
			'ここではいろいろなものが育ちます。',
			'個人開発、AI ツール、一人会社の実践記録。',
			'コードも書く、ビジネスも書く。',
		],
		ctaPrimary: '論文フォーマットツール（無料）',
		ctaSecondary: '記事を読む',
		afdianLabel: 'Afdian',
		productsTitle: '製品とサービス',
