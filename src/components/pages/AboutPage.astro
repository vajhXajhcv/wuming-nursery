---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { DEFAULT_LOCALE, type Locale } from '../../i18n/config';

interface Props {
	lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;

const dicts = {
	zh: {
		title: `关于 - ${SITE_TITLE}`,
		description: SITE_DESCRIPTION,
		heroImgAlt: '头像',
		heroTitle: '关于我',
		heroDesc: '「花园主」— 正在创作 GitHub 仓库新项目与 wumingmp.me 个人网站',
		gardenMarker: '🌱 自留区 —— 关于花园主本人、这座苗圃，以及那些还在发芽的想法。',
		sec1Title: '🌱 这里是「无名苗圃」',
		sec1P1: '无名苗圃不只是博客，它是一个正在生长的<strong>一人公司实验场</strong>。',
		sec1P2: '我会在这里记录独立开发的踩坑过程、AI 工具的实测体验、从 0 到 1 做产品的思考，以及那些还没名字但正在发芽的想法。',
		sec1P3: '如果你也在探索「用代码和内容养活自己」这条路，欢迎订阅、交流、或者直接用右侧的方式找到我。',
		sec2Title: '💡 我能提供什么',
		offers: [
			{ label: '🛠 网站开发', desc: '个人品牌站、Landing Page、博客搭建。Astro + Cloudflare，快、省、SEO 友好。' },
			{ label: '🤖 AI 自动化', desc: '内容生成管线、智能客服、AI 工作流搭建。让重复劳动消失，把时间留给创造。' },
			{ label: '📄 文档工具', desc: 'Markdown 转学术 Word、批量排版、模板定制。基于自研 docx-formatter-cn 工具链。' },
			{ label: '✍️ 内容策略', desc: 'SEO 技术文章、Newsletter、产品文档。用内容换长期流量，用流量换可持续收入。' },
		],
		sec3Title: '📌 时间线',
		timeline: [
			{ date: '2026 年 6 月', event: '网站定位升级：从个人博客转向一人公司与创作者品牌' },
			{ date: '2026 年 6 月', event: '发布《一人公司完全指南》系列文章，探索独立开发路径' },
			{ date: '2026 年 5 月', event: '搭建「无名苗圃」个人网站，基于 Astro + Cloudflare Pages' },
			{ date: '2026 年 5 月', event: '开发 docx-formatter-cn — 中文 Word 文档智能排版工具' },
		],
		sec4Title: '🔗 找到我',
		linkGithub: 'GitHub',
		linkAfdian: '爱发电',
		linkRss: 'RSS',
	},
	en: {
		title: `About - ${SITE_TITLE}`,
		description: 'Independent developer · Technical content creator · One-person company explorer. Building a sustainable creator business with code, content, and AI tools.',
		heroImgAlt: 'Avatar',
		heroTitle: 'About Me',
		heroDesc: 'The “Gardener” — currently building new GitHub projects and the wumingmp.me personal site',
		gardenMarker: '🌱 Private Corner — about the gardener himself, this nursery, and the ideas still sprouting.',
		sec1Title: '🌱 This Is “Wuming Nursery”',
		sec1P1: 'Wuming Nursery is more than a blog — it is a growing <strong>one-person company experiment</strong>.',
		sec1P2: 'Here I document the pitfalls of independent development, hands-on reviews of AI tools, thoughts on building products from 0 to 1, and the nameless ideas that are still sprouting.',
		sec1P3: 'If you are also exploring the path of “making a living with code and content”, feel free to subscribe, chat, or reach me through the links below.',
		sec2Title: '💡 What I Offer',
		offers: [
			{ label: '🛠 Web Development', desc: 'Personal brand sites, landing pages, blog setups. Astro + Cloudflare: fast, affordable, SEO-friendly.' },
			{ label: '🤖 AI Automation', desc: 'Content generation pipelines, smart customer support, AI workflow setups. Make repetitive work disappear and keep time for creating.' },
			{ label: '📄 Document Tooling', desc: 'Markdown to academic Word, batch formatting, custom templates. Built on the self-developed docx-formatter-cn toolchain.' },
			{ label: '✍️ Content Strategy', desc: 'Technical SEO articles, newsletters, product documentation. Trade content for long-term traffic, and traffic for sustainable income.' },
		],
		sec3Title: '📌 Timeline',
		timeline: [
			{ date: 'June 2026', event: 'Site repositioning upgrade: from personal blog to one-person company and creator brand' },
			{ date: 'June 2026', event: 'Published the “Complete Guide to One-Person Companies” article series, exploring the indie development path' },
			{ date: 'May 2026', event: 'Built the “Wuming Nursery” personal site, based on Astro + Cloudflare Pages' },
			{ date: 'May 2026', event: 'Developed docx-formatter-cn — a smart formatting tool for Chinese Word documents' },
		],
		sec4Title: '🔗 Find Me',
		linkGithub: 'GitHub',
		linkAfdian: 'Afdian',
		linkRss: 'RSS',
	},
	ja: {
		title: `について - ${SITE_TITLE}`,
		description: '独立開発者 · テクニカルクリエイター · 一人会社の探索者。コード、コンテンツ、AI ツールで持続可能なクリエイタービジネスを構築。',
		heroImgAlt: 'アバター',
		heroTitle: '私について',
		heroDesc: '「ガーデナー」— GitHub の新プロジェクトと個人サイト wumingmp.me を制作中',
		gardenMarker: '🌱 自留エリア —— ガーデナー本人、この苗圃、そしてまだ芽吹き途中のアイデアについて。',
		sec1Title: '🌱 ここは「無名苗圃」',
		sec1P1: '無名苗圃は単なるブログではなく、成長中の<strong>一人会社の実験場</strong>です。',
		sec1P2: '独立開発の失敗談、AI ツールの実測レビュー、0 から 1 のプロダクトづくりの考察、そしてまだ名前もない芽生えつつあるアイデアを記録しています。',
		sec1P3: '「コードとコンテンツで生計を立てる」道を探っている方は、ぜひ購読・交流、または下のリンクからご連絡ください。',
		sec2Title: '💡 提供できること',
		offers: [
			{ label: '🛠 ウェブ開発', desc: 'ブランドサイト、ランディングページ、ブログ構築。Astro + Cloudflare で、速く、低コスト、SEO に強い。' },
			{ label: '🤖 AI 自動化', desc: 'コンテンツ生成パイプライン、スマートカスタマー対応、AI ワークフロー構築。繰り返し作業を消し、創造の時間を残す。' },
			{ label: '📄 ドキュメントツール', desc: 'Markdown → 学術 Word、一括整形、テンプレートカスタム。自開発の docx-formatter-cn ツールチェーンベース。' },
			{ label: '✍️ コンテンツ戦略', desc: 'SEO 技術記事、ニュースレター、製品ドキュメント。コンテンツで長期的なトラフィックを、トラフィックで持続可能な収入を。' },
		],
		sec3Title: '📌 タイムライン',
		timeline: [
			{ date: '2026 年 6 月', event: 'サイトの方向性をアップグレード：個人ブログから一人会社・クリエイターブランドへ' },
			{ date: '2026 年 6 月', event: '『一人会社完全ガイド』シリーズを公開、独立開発の道を探求' },
			{ date: '2026 年 5 月', event: '個人サイト「無名苗圃」を構築、Astro + Cloudflare Pages ベース' },
			{ date: '2026 年 5 月', event: 'docx-formatter-cn を開発 — 中国語 Word ドキュメントのスマート整形ツール' },
		],
		sec4Title: '🔗 連絡先',
		linkGithub: 'GitHub',
		linkAfdian: 'Afdian',
		linkRss: 'RSS',
	},
} as const;

const t = dicts[lang];
---

<BaseLayout title={t.title} description={t.description} lang={lang}>
	<style>
		main {
			width: var(--content-width);
			max-width: calc(100% - 2em);
			margin: auto;
			padding: 2.5em 1em;
		}
		.about-hero {
			padding: 1em 0 0.5em;
		}
		.about-hero img {
			width: 88px;
			height: 88px;
			border-radius: 50%;
			border: 2px solid var(--border);
			margin-bottom: 1em;
		}
		.about-hero h1 {
			font-size: 1.5em;
			margin: 0 0 0.3em;
		}
		.about-hero p {
			color: var(--text-secondary);
			margin: 0;
			font-size: 0.95em;
		}
		.section {
			margin: 2.5em 0;
		}
		.section h2 {
			font-size: 1.25em;
			margin-bottom: 0.8em;
			padding-bottom: 0.4em;
			border-bottom: 1px solid var(--border);
		}
		.section p {
			line-height: 1.8;
		}
		.garden-marker {
			text-align: center;
			font-size: 0.85em;
			color: var(--text-secondary);
			background: var(--accent-soft);
			border: 1px solid var(--border);
			border-radius: var(--radius-md);
			padding: 0.6em 1.2em;
			max-width: 520px;
			margin: 0 auto 1.5em;
		}
		.timeline {
			position: relative;
			padding-left: 1.5em;
		}
		.timeline::before {
			content: '';
			position: absolute;
			left: 0;
			top: 0.5em;
			bottom: 0.5em;
			width: 2px;
			background: var(--border);
			border-radius: 2px;
		}
		.timeline-item {
			position: relative;
			margin-bottom: 1.5em;
		}
		.timeline-item::before {
			content: '';
			position: absolute;
			left: -1.62em;
			top: 0.45em;
			width: 9px;
			height: 9px;
			border-radius: 50%;
			background: var(--accent);
		}
		.timeline-item .date {
			font-size: 0.85em;
			color: var(--text-secondary);
			margin-bottom: 0.2em;
		}
		.links {
			display: flex;
			gap: 0.8em;
			flex-wrap: wrap;
			margin-top: 1em;
		}
		.links a {
			display: inline-flex;
			align-items: center;
			gap: 0.4em;
			padding: 0.55em 1em;
			border-radius: var(--radius-md);
			border: 1px solid var(--border);
			background: var(--bg-elevated);
			color: var(--text);
			text-decoration: none;
			font-size: 0.9em;
			transition: border-color 0.2s, color 0.15s;
		}
		.links a:hover {
			border-color: var(--accent);
			color: var(--accent);
		}
		@media (max-width: 720px) {
			.about-hero h1 { font-size: 1.4em; }
		}
	</style>

	<main>
		<section class="about-hero">
			<img src="/avatar.png" alt={t.heroImgAlt} />
			<h1>{t.heroTitle}</h1>
			<p>{t.heroDesc}</p>
		</section>

		<div class="garden-marker">{t.gardenMarker}</div>

		<section class="section">
			<h2>{t.sec1Title}</h2>
			<p set:html={t.sec1P1} />
			<p>{t.sec1P2}</p>
			<p>{t.sec1P3}</p>
		</section>

		<section class="section">
			<h2>{t.sec2Title}</h2>
			<div class="timeline">
				{t.offers.map((o) => (
					<div class="timeline-item">
						<div class="date">{o.label}</div>
						<div class="content">{o.desc}</div>
					</div>
				))}
			</div>
		</section>

		<section class="section">
			<h2>{t.sec3Title}</h2>
			<div class="timeline">
				{t.timeline.map((item) => (
					<div class="timeline-item">
						<div class="date">{item.date}</div>
						<div class="content">{item.event}</div>
					</div>
				))}
			</div>
		</section>

		<section class="section">
			<h2>{t.sec4Title}</h2>
			<div class="links">
				<a href="https://github.com/vajhxajhcv" target="_blank" rel="noopener">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
					{t.linkGithub}
				</a>
				<a href="https://afdian.com/a/jk342joy" target="_blank" rel="noopener">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
					{t.linkAfdian}
				</a>
				<a href="/rss.xml">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6.503 20.752c0 1.794-1.456 3.248-3.251 3.248-1.796 0-3.252-1.454-3.252-3.248 0-1.794 1.456-3.248 3.252-3.248 1.795.001 3.251 1.454 3.251 3.248zm-6.503-12.572v4.811c6.05.062 10.96 4.966 11.022 11.009h4.817c-.062-8.71-7.118-15.758-15.839-15.82zm0-3.368c10.58.046 19.152 8.594 19.183 19.188h4.817c-.03-13.231-10.739-23.98-24-24.026v4.838z"/></svg>
					{t.linkRss}
				</a>
			</div>
		</section>
	</main>
</BaseLayout>
