---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	function slugify(text: string) {
		return text
			.trim()
			.replace(/\//g, '-')
			.replace(/\s+/g, '-');
	}

	const allPosts = [...(await getCollection('blog')), ...(await getCollection('notes'))].filter(
		(post) => !post.data.draft,
	);
	const tagMap = new Map<string, typeof allPosts>();

	allPosts.forEach((post) => {
		const tags = post.data.tags || [];
		tags.forEach((tag) => {
			if (!tagMap.has(tag)) tagMap.set(tag, []);
			tagMap.get(tag)!.push(post);
		});
	});

	return Array.from(tagMap.entries()).map(([tag, posts]) => ({
		params: { tag: slugify(tag) },
		props: {
			tag,
			posts: posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

const { tag, posts } = Astro.props;
const title = `标签：${tag} - ${SITE_TITLE}`;
const description = `查看「${tag}」相关的内容，共 ${posts.length} 篇。`;
---

<BaseLayout title={title} description={description} >
		<style>
			main {
				width: var(--content-width);
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2.5em 1em;
			}
			.back-link {
				display: inline-flex;
				align-items: center;
				gap: 0.3em;
				margin-bottom: 1em;
				color: var(--text-secondary);
				text-decoration: none;
				font-size: 0.88em;
			}
			.back-link:hover {
				color: var(--accent);
			}
			.page-title {
				font-size: 1.45em;
				margin-bottom: 0.3em;
			}
			.page-title .tag {
				color: var(--accent);
			}
			.page-desc {
				color: var(--text-secondary);
				font-size: 0.95em;
				margin-bottom: 1.8em;
			}
			.post-list {
				display: flex;
				flex-direction: column;
			}
			.post-card {
				display: flex;
				align-items: baseline;
				gap: 1em;
				padding: 0.75em 0.2em;
				border-bottom: 1px solid var(--border);
				text-decoration: none;
				color: inherit;
			}
			.post-card:hover .post-title {
				color: var(--accent);
			}
			.post-title {
				font-size: 0.95em;
				flex: 1;
				min-width: 0;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
				transition: color 0.15s;
			}
			.post-type {
				font-size: 0.72em;
				padding: 0.15em 0.6em;
				border-radius: 999px;
				background: var(--accent-soft);
				color: var(--accent);
				white-space: nowrap;
				flex-shrink: 0;
			}
			.post-date {
				font-size: 0.78em;
				color: var(--text-secondary);
				white-space: nowrap;
				font-variant-numeric: tabular-nums;
				flex-shrink: 0;
			}
			.empty {
				text-align: center;
				color: var(--text-secondary);
				padding: 4em 0;
			}
			@media (max-width: 720px) {
				.post-card {
					gap: 0.6em;
				}
			}
		</style>
	<main>
			<a href="/tags" class="back-link">← 全部标签</a>
			<h1 class="page-title">标签：<span class="tag">{tag}</span></h1>
			<p class="page-desc">共 {posts.length} 篇相关内容</p>

			{posts.length === 0 && (
				<div class="empty">🌱 这个标签下还没有内容。</div>
			)}

			<div class="post-list">
				{posts.map((post) => (
					<a href={`/${post.collection}/${post.id}/`} class="post-card">
						<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
						<span class="post-title">{post.data.title}</span>
						<span class="post-type">{post.collection === 'blog' ? '文章' : '笔记'}</span>
					</a>
				))}
			</div>
	</main>
</BaseLayout>
