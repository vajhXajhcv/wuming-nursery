---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

function slugify(text: string) {
	return text
		.trim()
		.replace(/\//g, '-')
		.replace(/\s+/g, '-');
}

const allPosts = [...(await getCollection('blog')), ...(await getCollection('notes'))].filter(
	(post) => !post.data.draft,
);

// Build tag map: tag -> posts[]
const tagMap = new Map<string, typeof allPosts>();
allPosts.forEach((post) => {
	const tags = post.data.tags || [];
	tags.forEach((tag) => {
		if (!tagMap.has(tag)) tagMap.set(tag, []);
		tagMap.get(tag)!.push(post);
	});
});

// Sort tags by post count desc, then alphabetically
const sortedTags = Array.from(tagMap.entries()).sort((a, b) => {
	const diff = b[1].length - a[1].length;
	return diff !== 0 ? diff : a[0].localeCompare(b[0]);
});

const totalTags = sortedTags.length;
const totalPosts = allPosts.length;
---

<BaseLayout title={`标签 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} >
		<style>
			main {
				width: var(--content-width);
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2.5em 1em;
			}
			.page-title {
				font-size: 1.45em;
				margin-bottom: 0.3em;
			}
			.page-desc {
				color: var(--text-secondary);
				font-size: 0.95em;
				margin-bottom: 1.8em;
			}
			.tag-cloud {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				margin-bottom: 2.5em;
			}
			.tag-pill {
				display: inline-flex;
				align-items: center;
				gap: 0.35em;
				padding: 0.35em 0.9em;
				border-radius: 999px;
				border: 1px solid var(--border);
				background: var(--bg-elevated);
				color: var(--text);
				text-decoration: none;
				font-size: 0.88em;
				transition: border-color 0.2s, color 0.15s;
			}
			.tag-pill:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
			.tag-pill .count {
				font-size: 0.75em;
				color: var(--text-secondary);
			}
			.tag-section {
				margin-bottom: 2.2em;
			}
			.tag-section h3 {
				display: flex;
				align-items: baseline;
				gap: 0.5em;
				font-size: 1.1em;
				margin-bottom: 0.2em;
				padding-bottom: 0.4em;
				border-bottom: 1px solid var(--border);
			}
			.tag-section h3 .badge {
				font-size: 0.65em;
				padding: 0.1em 0.55em;
				border-radius: 999px;
				background: var(--accent-soft);
				color: var(--accent);
			}
			.post-list {
				display: flex;
				flex-direction: column;
			}
			.post-list a {
				display: flex;
				align-items: baseline;
				gap: 1em;
				padding: 0.65em 0.2em;
				border-bottom: 1px solid var(--border);
				text-decoration: none;
				color: inherit;
			}
			.post-list a:last-child {
				border-bottom: none;
			}
			.post-list a:hover .title {
				color: var(--accent);
			}
			.post-list a .title {
				font-size: 0.95em;
				flex: 1;
				min-width: 0;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
				transition: color 0.15s;
			}
			.post-list a .date {
				font-size: 0.78em;
				color: var(--text-secondary);
				white-space: nowrap;
				font-variant-numeric: tabular-nums;
				flex-shrink: 0;
			}
			.empty {
				text-align: center;
				color: var(--text-secondary);
				padding: 4em 0;
			}
		</style>
	<main>
			<h1 class="page-title">标签</h1>
			<p class="page-desc">共 {totalTags} 个标签，{totalPosts} 篇文章</p>

			{sortedTags.length === 0 && (
				<div class="empty">🌱 还没有标签，等文章长出来...</div>
			)}

			{sortedTags.length > 0 && (
				<div class="tag-cloud">
					{sortedTags.map(([tag, posts]) => (
						<a href={`/tags/${slugify(tag)}/`} class="tag-pill">
							{tag}
							<span class="count">{posts.length}</span>
						</a>
					))}
				</div>
			)}

			{sortedTags.map(([tag, posts]) => (
				<div class="tag-section" id={`tag-${tag}`}>
					<h3>
						<a href={`/tags/${slugify(tag)}/`} style="color: inherit; text-decoration: none;">
							{tag}
						</a>
						<span class="badge">{posts.length}</span>
					</h3>
					<div class="post-list">
						{posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).map((post) => (
							<a href={`/${post.collection}/${post.id}/`}>
								<span class="date"><FormattedDate date={post.data.pubDate} /></span>
								<span class="title">{post.data.title}</span>
							</a>
						))}
					</div>
				</div>
			))}
	</main>
</BaseLayout>
