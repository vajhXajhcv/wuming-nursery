---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const pages = [
	{ title: '首页', url: '/' },
	{ title: '写作', url: '/blog' },
	{ title: '关于', url: '/about' },
	{ title: '项目', url: '/projects/docx-formatter-cn' },
	{ title: '使用文档', url: '/projects/docx-formatter-docs' },
	{ title: 'DAO 总览', url: '/dao' },
	{ title: '共同体章程', url: '/dao/charter' },
	{ title: '共同体成员', url: '/dao/members' },
	{ title: '加入共同体', url: '/dao/join' },
	{ title: '治理提案', url: '/dao/proposals' },
	{ title: '发起提案', url: '/dao/propose' },
	{ title: '公开账本', url: '/ledger' },
];
---

<BaseLayout title={`网站地图 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} >
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2em 1em;
			}
			.page-title {
				font-size: 1.45em;
				margin-bottom: 0.2em;
			}
			.page-desc {
				color: var(--text-secondary);
				margin-bottom: 2em;
				font-size: 0.95em;
			}
			.section {
				margin: 2em 0;
			}
			.section h2 {
				font-size: 1.2em;
				padding-bottom: 0.4em;
				border-bottom: 1px solid var(--border);
				margin-bottom: 0.6em;
			}
			.link-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.link-list li {
				border-bottom: 1px dashed var(--border);
			}
			.link-list li:last-child {
				border-bottom: none;
			}
			.link-list a {
				color: var(--text);
				text-decoration: none;
				padding: 0.6em 0.2em;
				display: flex;
				align-items: baseline;
				gap: 1em;
				justify-content: space-between;
				transition: color 0.15s;
			}
			.link-list a:hover {
				color: var(--accent);
			}
			.link-list .meta {
				font-size: 0.78em;
				color: var(--text-secondary);
				white-space: nowrap;
				font-variant-numeric: tabular-nums;
			}
			.tag {
				font-size: 0.72em;
				padding: 0.1em 0.6em;
				border-radius: 999px;
				background: var(--accent-soft);
				color: var(--accent);
				margin-left: 0.5em;
			}
		</style>
	<main>
			<h1 class="page-title">网站地图</h1>
			<p class="page-desc">快速导航到网站的每一个角落</p>

			<section class="section">
				<h2>📄 页面</h2>
				<ul class="link-list">
					{pages.map((page) => (
						<li>
							<a href={page.url}>
								<span>{page.title}</span>
								<span class="meta">{page.url}</span>
							</a>
						</li>
					))}
				</ul>
			</section>

			<section class="section">
				<h2>📝 文章</h2>
				<ul class="link-list">
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<span>
									{post.data.title}
									{post.data.tags?.map((tag) => (
										<span class="tag">{tag}</span>
									))}
								</span>
								<span class="meta">
									<FormattedDate date={post.data.pubDate} />
								</span>
							</a>
						</li>
					))}
				</ul>
			</section>
	</main>
</BaseLayout>
