---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../consts';

const title = `账本录入 - ${SITE_TITLE}`;
const description = '手动录入收支记录（需要管理令牌）。';
---

<BaseLayout title={title} description={description} draft={true}>
	<style is:global>
		.add-form {
			max-width: 520px;
			margin: 0 auto;
		}
		.add-form h1 {
			font-size: 1.4em;
			margin: 0 0 1em;
		}
		.field {
			margin-bottom: 1em;
		}
		.field label {
			display: block;
			font-size: 0.85em;
			color: var(--text-secondary);
			margin-bottom: 0.3em;
		}
		.row {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 1em;
		}
		.btn-block {
			width: 100%;
			min-height: 44px;
		}
		.result {
			margin-top: 1em;
			padding: 0.7em 1em;
			border-radius: var(--radius-md);
			font-size: 0.88em;
			display: none;
		}
		.result.ok {
			display: block;
			background: var(--accent-soft);
			color: var(--accent);
			word-break: break-all;
		}
		.result.err {
			display: block;
			background: rgba(220, 38, 38, 0.08);
			color: var(--c-err);
		}
	</style>
	<main>
		<div class="card add-form">
			<h1>账本录入（手动渠道）</h1>
			<div class="field">
				<label for="admin-token">管理令牌</label>
				<input type="password" id="admin-token" class="input" placeholder="ADMIN_TOKEN" />
			</div>
			<div class="row">
				<div class="field">
					<label for="entry-type">类型</label>
					<select id="entry-type" class="input">
						<option value="income">收入</option>
						<option value="expense">支出</option>
					</select>
				</div>
				<div class="field">
					<label for="entry-amount">金额（元）</label>
					<input type="number" id="entry-amount" class="input" min="0.01" step="0.01" placeholder="0.00" />
				</div>
			</div>
			<div class="field">
				<label for="entry-category">分类</label>
				<input type="text" id="entry-category" class="input" placeholder="如：付费阅读 / 办公支出 / 捐款" />
			</div>
			<div class="field">
				<label for="entry-note">摘要</label>
				<textarea id="entry-note" class="textarea" rows="2" placeholder="一句话说明这笔收支"></textarea>
			</div>
			<div class="field">
				<label for="entry-ref">关联单号（可选）</label>
				<input type="text" id="entry-ref" class="input" placeholder="如发票号、流水号" />
			</div>
			<button class="btn btn-primary btn-block" id="submit-btn">写入账本</button>
			<div class="result" id="result"></div>
		</div>
	</main>

	<script>
		import { apiPost } from '../../lib/dao-ui';

		const tokenInput = document.getElementById('admin-token') as HTMLInputElement;
		const btn = document.getElementById('submit-btn') as HTMLButtonElement;
		const result = document.getElementById('result') as HTMLElement;
		try {
			tokenInput.value = localStorage.getItem('ledger:admin-token') || '';
		} catch {}

		function show(msg: string, ok: boolean) {
			result.textContent = msg;
			result.className = 'result ' + (ok ? 'ok' : 'err');
		}

		btn.addEventListener('click', async () => {
			const token = tokenInput.value.trim();
			if (!token) {
				show('请先输入管理令牌。', false);
				return;
			}
			const payload = {
				type: (document.getElementById('entry-type') as HTMLSelectElement).value,
				amount: (document.getElementById('entry-amount') as HTMLInputElement).value,
				category: (document.getElementById('entry-category') as HTMLInputElement).value.trim(),
				note: (document.getElementById('entry-note') as HTMLTextAreaElement).value.trim(),
				ref: (document.getElementById('entry-ref') as HTMLInputElement).value.trim(),
			};
			if (!payload.amount || !payload.category || !payload.note) {
				show('金额、分类、摘要为必填项。', false);
				return;
			}
			btn.disabled = true;
			try {
				const data = await apiPost<{ seq: number; hash: string }>('/api/ledger/add', payload, token);
				try {
					localStorage.setItem('ledger:admin-token', token);
				} catch {}
				show('✅ 已写入第 ' + data.seq + ' 条，哈希：' + data.hash, true);
				(document.getElementById('entry-amount') as HTMLInputElement).value = '';
				(document.getElementById('entry-note') as HTMLTextAreaElement).value = '';
				(document.getElementById('entry-ref') as HTMLInputElement).value = '';
			} catch (err) {
				show((err as Error).message || '写入失败。', false);
			} finally {
				btn.disabled = false;
			}
		});
	</script>
</BaseLayout>
