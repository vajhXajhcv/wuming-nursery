---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatCards from '../../components/dao/StatCards.astro';
import ChainStatus from '../../components/dao/ChainStatus.astro';
import { SITE_TITLE } from '../../consts';

const title = `公开账本 - ${SITE_TITLE}`;
const description = '每一笔收入与支出公开记录，哈希链防篡改，任何人可独立验证完整性。';
---

<BaseLayout title={title} description={description}>
	<style is:global>
		.page-header {
			margin-bottom: 1.5em;
		}
		.page-header h1 {
			font-size: 1.5em;
			margin: 0 0 0.3em;
		}
		.page-header p {
			color: var(--text-secondary);
			font-size: 0.9em;
			margin: 0;
		}
		.ledger-table-wrapper {
			overflow-x: auto;
		}
		.ledger-table td {
			white-space: nowrap;
		}
		.ledger-table td.note {
			white-space: normal;
			min-width: 12em;
		}
		.amount-in {
			color: var(--c-ok);
			font-variant-numeric: tabular-nums;
		}
		.amount-out {
			color: var(--c-err);
			font-variant-numeric: tabular-nums;
		}
		.hash-cell {
			font-family: monospace;
			font-size: 0.78em;
			color: var(--text-secondary);
		}
		.explain {
			margin-top: 2.5em;
			padding: 1.2em 1.4em;
			background: var(--bg-elevated);
			border: 1px solid var(--border);
			border-radius: var(--radius-lg);
			font-size: 0.85em;
			color: var(--text-secondary);
			line-height: 1.7;
		}
		.explain strong {
			color: var(--text);
		}
		.explain code {
			font-size: 0.85em;
		}
	</style>
	<main>
		<div class="page-header">
			<h1>公开账本</h1>
			<p>每一笔收入与支出公开记录。哈希链防篡改，任何人可独立验证。</p>
		</div>

		<StatCards min="140px">
			<div class="stat-card">
				<div class="stat-label">总收入</div>
				<div class="stat-value income" id="stat-in">¥0.00</div>
			</div>
			<div class="stat-card">
				<div class="stat-label">总支出</div>
				<div class="stat-value expense" id="stat-out">¥0.00</div>
			</div>
			<div class="stat-card">
				<div class="stat-label">结余</div>
				<div class="stat-value" id="stat-balance">¥0.00</div>
			</div>
			<div class="stat-card">
				<div class="stat-label">记录数</div>
				<div class="stat-value" id="stat-count">0</div>
			</div>
		</StatCards>

		<ChainStatus buttonLabel="独立验证哈希链" />

		<div class="ledger-table-wrapper">
			<table class="table ledger-table">
				<thead>
					<tr>
						<th>#</th>
						<th>时间</th>
						<th>类型</th>
						<th>分类</th>
						<th>摘要</th>
						<th>金额</th>
						<th>来源</th>
						<th>哈希</th>
					</tr>
				</thead>
				<tbody id="ledger-body">
					<tr>
						<td colspan="8" class="empty">⏳ 加载中…</td>
					</tr>
				</tbody>
			</table>
		</div>

		<div class="explain">
			<strong>这个账本如何防篡改？</strong><br />
			每条记录包含上一条记录的哈希值，形成哈希链：<code>hash = SHA256(prev|序号|时间|类型|金额|分类|摘要|来源|单号)</code>；记录含 data 负载时（DAO 事件），负载的规范化 JSON 一并参与哈希。
			修改任何一条历史记录，其后所有哈希都会失配。上方「独立验证哈希链」按钮在你的浏览器里重算整条链，不经过服务器。
			记录一旦写入即不可更改，更正以反向冲正的新记录呈现。本链同时承载 DAO 治理事件（成员/贡献/提案/投票/决议/执行），详见 <a href="/dao">/dao</a>。后续计划：每周把链头哈希锚定到比特币区块链（OpenTimestamps），获得公开时间证明。
		</div>
	</main>

	<script>
		import { loadChain, escapeHtml, fmtTime, fmtMoney, errorHtml, bindRetry } from '../../lib/dao-ui';

		const SRC_LABELS: Record<string, string> = {
			manual: '手动',
			alipay: '自动·支付宝',
			afdian: '自动·爱发电',
			dao: 'DAO',
		};

		async function init() {
			const body = document.getElementById('ledger-body') as HTMLElement;
			let c;
			try {
				c = await loadChain();
			} catch (err) {
				body.innerHTML = '<tr><td colspan="8">' + errorHtml((err as Error).message || '加载失败，请刷新重试。') + '</td></tr>';
				bindRetry(body, init);
				return;
			}
			const { records } = c;
			// 表格与统计只取财务记录；DAO 治理事件不进账本表格（详见 /dao）
			const fin = records.filter((r) => r.type === 'income' || r.type === 'expense');

			// 统计
			let tin = 0;
			let tout = 0;
			for (const r of fin) {
				if (r.type === 'income') tin += parseFloat(r.amount) || 0;
				else tout += parseFloat(r.amount) || 0;
			}
			document.getElementById('stat-in')!.textContent = fmtMoney(tin);
			document.getElementById('stat-out')!.textContent = fmtMoney(tout);
			document.getElementById('stat-balance')!.textContent = fmtMoney(tin - tout);
			document.getElementById('stat-count')!.textContent = String(fin.length);

			// 表格
			if (!fin.length) {
				body.innerHTML = '<tr><td colspan="8" class="empty">暂无记录</td></tr>';
			} else {
				body.innerHTML = fin
					.slice()
					.reverse()
					.map((r) => {
						const isIn = r.type === 'income';
						const srcLabel = SRC_LABELS[r.source] || r.source;
						const srcClass = r.source === 'manual' ? 'badge badge-neutral' : 'badge';
						return (
							'<tr><td>' + r.seq + '</td><td>' + fmtTime(r.ts) + '</td>' +
							'<td>' + (isIn ? '收入' : '支出') + '</td>' +
							'<td>' + escapeHtml(r.category) + '</td>' +
							'<td class="note">' + escapeHtml(r.note) + '</td>' +
							'<td class="' + (isIn ? 'amount-in' : 'amount-out') + '">' + (isIn ? '+' : '-') + '¥' + r.amount + '</td>' +
							'<td><span class="' + srcClass + '">' + srcLabel + '</span></td>' +
							'<td class="hash-cell" title="' + r.hash + '">' + r.hash.slice(0, 10) + '…</td></tr>'
						);
					})
					.join('');
			}
		}

		init();
	</script>
</BaseLayout>
