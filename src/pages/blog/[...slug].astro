---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import Paywall from '../../components/Paywall.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);

// Get prev/next posts (drafts excluded from navigation & related)
const allPosts = (await getCollection('blog'))
	.filter((p) => !p.data.draft)
	.sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const currentIndex = allPosts.findIndex((p) => p.id === post.id);
const prevPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;

// Estimate reading time (~500 chars per minute for Chinese)
const wordCount = post.body?.length || 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 500));
const displayWordCount = wordCount;

// Find related posts by tag overlap
const currentTags = new Set(post.data.tags || []);
const relatedPosts = allPosts
	.filter((p) => p.id !== post.id)
	.map((p) => {
		const pTags = new Set(p.data.tags || []);
		const overlap = [...currentTags].filter((t) => pTags.has(t)).length;
		return { post: p, overlap };
	})
	.filter((p) => p.overlap > 0)
	.sort((a, b) => b.overlap - a.overlap)
	.slice(0, 3)
	.map((p) => p.post);
---

<BlogPost {...post.data} prevPost={prevPost} nextPost={nextPost} readingTime={readingTime} wordCount={displayWordCount} relatedPosts={relatedPosts}>
	{post.data.paid ? (
		<>
			<p class="paid-excerpt">{post.data.description}</p>
			<Paywall slug={post.id} wordCount={displayWordCount} />
		</>
	) : (
		<Content />
	)}
</BlogPost>

<style>
	.paid-excerpt {
		padding: 0.9em 1.2em;
		border-left: 4px solid var(--accent);
		background: var(--accent-soft);
		border-radius: 0 8px 8px 0;
		color: var(--text);
		line-height: 1.7;
	}
</style>
