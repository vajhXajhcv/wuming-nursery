---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
---

<BaseLayout title={`写作 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} >
		<style>
			main {
				width: var(--content-width);
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2.5em 1em;
			}
			.page-title {
				font-size: 1.45em;
				margin-bottom: 0.3em;
			}
			.page-desc {
				color: var(--text-secondary);
				font-size: 0.95em;
				margin-bottom: 1em;
			}
			.garden-marker {
				display: inline-block;
				font-size: 0.85em;
				color: var(--text-secondary);
				background: var(--accent-soft);
				border: 1px solid var(--border);
				border-radius: 999px;
				padding: 0.45em 1.2em;
				margin-bottom: 1.8em;
			}
			.search-box {
				max-width: 400px;
				margin-bottom: 2em;
				position: relative;
			}
			.search-box input {
				width: 100%;
				padding: 0.6em 1em 0.6em 2.5em;
				border: 1px solid var(--border);
				border-radius: var(--radius-md);
				font-size: 0.95em;
				background: var(--bg-elevated);
				color: var(--text);
				transition: border-color 0.2s, box-shadow 0.2s;
			}
			.search-box input:focus {
				outline: none;
				border-color: var(--accent);
				box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);
			}
			.search-box svg {
				position: absolute;
				left: 1em;
				top: 50%;
				transform: translateY(-50%);
				color: var(--text-secondary);
				pointer-events: none;
			}
			.no-results {
				text-align: center;
				color: var(--text-secondary);
				padding: 3em 0;
				display: none;
			}
			.no-results.visible {
				display: block;
			}
			.post-grid {
				display: flex;
				flex-direction: column;
			}
			.post-card {
				display: flex;
				align-items: baseline;
				gap: 1em;
				padding: 0.75em 0.6em;
				margin: 0 -0.6em;
				border-bottom: 1px solid var(--border);
				border-radius: var(--radius-sm);
				text-decoration: none;
				color: inherit;
				transition: background 0.15s;
			}
			.post-card:hover {
				background: var(--accent-soft);
			}
			.post-card:hover .post-list-title {
				color: var(--accent);
			}
			.post-list-date {
				font-size: 0.78em;
				color: var(--text-secondary);
				white-space: nowrap;
				font-variant-numeric: tabular-nums;
				flex-shrink: 0;
			}
			.post-list-title {
				font-size: 0.95em;
				flex: 1;
				min-width: 0;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
				transition: color 0.15s;
			}
			.tag-group {
				display: flex;
				gap: 0.4em;
				flex-shrink: 0;
			}
			.tag {
				font-size: 0.72em;
				padding: 0.15em 0.6em;
				border-radius: 999px;
				background: var(--accent-soft);
				color: var(--accent);
				white-space: nowrap;
			}
			.tag-paid {
				background: var(--accent);
				color: white;
			}
			@media (max-width: 720px) {
				.post-card {
					gap: 0.6em;
				}
			}
		</style>
	<main>
			<h1 class="page-title">写作</h1>
			<p class="page-desc">独立开发、AI 工具、一人公司与创作者生意的实践记录</p>
			<div class="garden-marker">🌱 自留区 —— 这里是花园主的个人写作空间，不成体系，但真实。</div>
			<div class="search-box">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
				<input type="text" id="search-input" placeholder="搜索文章..." />
			</div>
			<div class="no-results" id="no-results">没有找到匹配的文章</div>
			<div class="post-grid" id="post-grid">
				{
					posts.map((post) => (
						<a href={`/blog/${post.id}/`} class="post-card" data-search={`${post.data.title} ${post.data.description} ${post.data.tags?.join(' ') || ''}`}>
							<span class="post-list-date"><FormattedDate date={post.data.pubDate} /></span>
							<span class="post-list-title">{post.data.title}</span>
							<span class="tag-group">
								{post.data.paid && <span class="tag tag-paid">付费</span>}
								{post.data.tags && post.data.tags.length > 0 ? (
									<span class="tag">{post.data.tags[0]}</span>
								) : (
									<span class="tag">文章</span>
								)}
							</span>
						</a>
					))
				}
			</div>
		</main>
		<script is:inline>
			document.addEventListener('DOMContentLoaded', function() {
				var input = document.getElementById('search-input');
				var grid = document.getElementById('post-grid');
				var noResults = document.getElementById('no-results');
				if (!input || !grid) return;
				var cards = grid.querySelectorAll('.post-card');
				input.addEventListener('input', function() {
					var q = input.value.trim().toLowerCase();
					var visible = 0;
					cards.forEach(function(card) {
						var text = (card.dataset.search || '').toLowerCase();
						if (!q || text.indexOf(q) !== -1) {
							card.style.display = '';
							visible++;
						} else {
							card.style.display = 'none';
						}
					});
					noResults.classList.toggle('visible', visible === 0);
				});
			});
		</script>
</BaseLayout>
