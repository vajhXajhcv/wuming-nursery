---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../consts';

const title = `论文排版服务 - ${SITE_TITLE}`;
const description = '按学校格式规范代排版本科、硕士、博士毕业论文。封面、目录、页眉页脚、参考文献、公式图表三线表一站式处理，交付后支持修改。';

const prices = [
	{ type: '本科毕业论文', price: '¥199', period: '3-5 天', desc: '含封面、目录、正文、图表、参考文献格式调整' },
	{ type: '硕士毕业论文', price: '¥299', period: '4-7 天', desc: '章节较多、图表公式多，含页眉页脚与分节处理' },
	{ type: '博士毕业论文', price: '¥399', period: '5-10 天', desc: '大篇幅、复杂结构，含多级标题与交叉引用' },
];

const addons = [
	{ name: '24h 加急', price: '+50%' },
	{ name: '学校模板深度定制', price: '¥100 起' },
	{ name: '参考文献 GB/T 7714 整理', price: '¥50 起' },
	{ name: '公式 / 三线表批量规范', price: '已包含' },
];

const process = [
	{ step: '01', title: '提交材料', desc: '发送论文 Word 或 Markdown、学校格式文件、学院模板。' },
	{ step: '02', title: '确认报价', desc: '根据篇幅、复杂度、加急需求给出明确价格和交付时间。' },
	{ step: '03', title: '专业排版', desc: '使用 docx-formatter-cn 工具链 + 人工校验，按规范调整。' },
	{ step: '04', title: '交付修改', desc: '交付 docx 源文件，支持 2 轮免费小修改。' },
];

const faqs = [
	{ q: '需要提供什么材料？', a: '论文内容（Word/Markdown 均可）、学校或学院的格式规范文件（PDF/Word）、任何特殊要求（如封面样式、页眉文字）。' },
	{ q: '我的论文会保密吗？', a: '不会对外公开、不会用于训练模型，仅用于本次排版服务。交付完成后本地副本会删除。' },
	{ q: '如果学校模板很特殊怎么办？', a: '可先发送模板评估。一般可通过自定义 JSON/YAML 模板实现；特别复杂的按工时加收定制费。' },
	{ q: '交付后还能修改吗？', a: '交付后 7 天内支持 2 轮免费小修改；若你后续大幅增改内容，可重新按篇幅报价。' },
	{ q: '怎么付款，能开发票吗？', a: '通过爱发电或企业转账付款，完成后可申请开具发票。' },
];
---

<BaseLayout title={title} description={description}>
	<style>
		main {
			width: 900px;
			max-width: calc(100% - 2em);
			margin: auto;
			padding: 2em 1em 4em;
		}
		.hero {
			text-align: center;
			padding: 2.5em 0 1.5em;
		}
		.hero h1 {
			font-size: 2.3em;
			margin: 0 0 0.3em;
		}
		.hero p {
			color: rgb(var(--gray));
			font-size: 1.05em;
			max-width: 620px;
			margin: 0 auto;
			line-height: 1.7;
		}

		.btn {
			display: inline-block;
			padding: 0.7em 1.6em;
			border-radius: 999px;
			text-decoration: none;
			font-weight: 600;
			transition: transform 0.15s, box-shadow 0.15s;
		}
		.btn:hover {
			transform: translateY(-2px);
		}
		.btn-primary {
			background: var(--accent);
			color: white;
			box-shadow: 0 4px 16px rgba(99, 102, 241, 0.3);
		}
		.btn-secondary {
			background: rgb(var(--gray-light));
			color: rgb(var(--gray-dark));
		}

		section {
			margin: 3em 0;
		}
		section h2 {
			font-size: 1.6em;
			margin-bottom: 1em;
			text-align: center;
		}

		.price-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
			gap: 1.2em;
			margin: 1.5em 0;
		}
		.price-card {
			background: var(--bg-card, #fff);
			border: 2px solid rgb(var(--gray-light));
			border-radius: 16px;
			padding: 1.5em;
			text-align: center;
			transition: border-color 0.2s;
		}
		.price-card:hover {
			border-color: var(--accent);
		}
		.price-card h3 {
			margin: 0 0 0.4em;
			font-size: 1.15em;
		}
		.price-card .price {
			font-size: 2em;
			font-weight: 800;
			color: var(--accent);
			margin: 0.3em 0;
		}
		.price-card .period {
			font-size: 0.9em;
			color: rgb(var(--gray));
		}
		.price-card p {
			margin: 0.8em 0 0;
			font-size: 0.9em;
			color: rgb(var(--gray));
			line-height: 1.6;
		}

		.addons {
			background: var(--bg-card, #fff);
			border: 1px solid rgb(var(--gray-light));
			border-radius: 12px;
			padding: 1.2em 1.5em;
		}
		.addons h3 {
			margin: 0 0 0.8em;
			font-size: 1.1em;
		}
		.addons ul {
			margin: 0;
			padding: 0;
			list-style: none;
		}
		.addons li {
			display: flex;
			justify-content: space-between;
			padding: 0.45em 0;
			border-bottom: 1px solid rgb(var(--gray-light));
			font-size: 0.95em;
		}
		.addons li:last-child {
			border-bottom: none;
		}
		.addons .addon-price {
			font-weight: 600;
			color: var(--accent);
		}

		.process-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
			gap: 1.2em;
		}
		.process-card {
			background: var(--bg-card, #fff);
			border: 1px solid rgb(var(--gray-light));
			border-radius: 12px;
			padding: 1.4em 1.2em;
			text-align: center;
		}
		.process-card .step {
			font-size: 2em;
			font-weight: 800;
			color: var(--accent);
			opacity: 0.2;
			line-height: 1;
			margin-bottom: 0.3em;
		}
		.process-card h4 {
			margin: 0 0 0.4em;
			font-size: 1.1em;
		}
		.process-card p {
			margin: 0;
			font-size: 0.9em;
			color: rgb(var(--gray));
			line-height: 1.6;
		}

		.deliver {
			background: #f0f4ff;
			border-radius: 16px;
			padding: 1.8em;
			border: 1px solid rgb(var(--gray-light));
		}
		[data-theme='dark'] .deliver {
			background: #1e1b4b;
		}
		.deliver h3 {
			margin: 0 0 0.8em;
			font-size: 1.2em;
		}
		.deliver ul {
			margin: 0;
			padding-left: 1.2em;
			line-height: 1.9;
			color: rgb(var(--gray-dark));
		}

		.faq-item {
			background: var(--bg-card, #fff);
			border-radius: 12px;
			border: 1px solid rgb(var(--gray-light));
			margin-bottom: 0.8em;
			overflow: hidden;
		}
		.faq-q {
			padding: 1em 1.2em;
			font-weight: 600;
			cursor: pointer;
			display: flex;
			justify-content: space-between;
			align-items: center;
		}
		.faq-q:hover {
			background: rgba(var(--gray-light), 0.3);
		}
		.faq-arrow {
			font-size: 0.8em;
			color: rgb(var(--gray));
			transition: transform 0.2s;
		}
		.faq-item.open .faq-arrow {
			transform: rotate(180deg);
		}
		.faq-a {
			max-height: 0;
			overflow: hidden;
			transition: max-height 0.3s ease;
		}
		.faq-item.open .faq-a {
			max-height: 300px;
		}
		.faq-a-inner {
			padding: 0 1.2em 1em;
			color: rgb(var(--gray-dark));
			line-height: 1.7;
			font-size: 0.95em;
		}

		.cta-box {
			background: linear-gradient(135deg, #f0f4ff 0%, #f8f9ff 100%);
			border-radius: 16px;
			padding: 2.5em 2em;
			text-align: center;
			border: 1px solid rgb(var(--gray-light));
			margin-top: 3em;
		}
		[data-theme='dark'] .cta-box {
			background: linear-gradient(135deg, #1e1b4b 0%, #172554 100%);
		}
		.cta-box h2 {
			margin: 0 0 0.4em;
			font-size: 1.5em;
		}
		.cta-box p {
			color: rgb(var(--gray));
			margin: 0 0 1.2em;
		}

		@media (max-width: 720px) {
			.hero h1 { font-size: 1.8em; }
		}
	</style>

	<main>
		<section class="hero">
			<h1>论文排版服务</h1>
			<p>把论文和格式要求发给我，我按学校规范帮你排好。省心、专业、支持修改，适合临近答辩、时间紧张的你。</p>
			<div style="margin-top:1.5em;">
				<a href="/contact" class="btn btn-primary">立即咨询</a>
				<a href="/pricing" class="btn btn-secondary">查看定价</a>
			</div>
		</section>

		<section>
			<h2>按篇透明报价</h2>
			<div class="price-grid">
				{prices.map((p) => (
					<div class="price-card">
						<h3>{p.type}</h3>
						<div class="price">{p.price}</div>
						<div class="period">交付周期：{p.period}</div>
						<p>{p.desc}</p>
					</div>
				))}
			</div>
			<div class="addons">
				<h3>可选加项</h3>
				<ul>
					{addons.map((a) => (
						<li>
							<span>{a.name}</span>
							<span class="addon-price">{a.price}</span>
						</li>
					))}
				</ul>
			</div>
		</section>

		<section>
			<h2>服务流程</h2>
			<div class="process-grid">
				{process.map((p) => (
					<div class="process-card">
						<div class="step">{p.step}</div>
						<h4>{p.title}</h4>
						<p>{p.desc}</p>
					</div>
				))}
			</div>
		</section>

		<section>
			<div class="deliver">
				<h3>你将收到</h3>
				<ul>
					<li>符合学校格式规范的 <strong>.docx</strong> 源文件</li>
					<li>自动生成/调整后的目录、页眉、页脚、页码</li>
					<li>规范后的标题层级、图表编号、公式编号</li>
					<li>标准学术三线表与参考文献格式</li>
				</ul>
			</div>
		</section>

		<section>
			<h2>常见问题</h2>
			{faqs.map((f, i) => (
				<div class="faq-item" data-faq={i}>
					<div class="faq-q">
						{f.q}
						<span class="faq-arrow">▼</span>
					</div>
					<div class="faq-a">
						<div class="faq-a-inner">{f.a}</div>
					</div>
				</div>
			))}
		</section>

		<section class="cta-box">
			<h2>还在纠结格式？先聊聊</h2>
			<p>发我你的论文和格式要求，我会在 24h 内给出报价和交付时间。</p>
			<a href="/contact" class="btn btn-primary">开始咨询 →</a>
		</section>
	</main>

	<script is:inline>
		document.addEventListener('DOMContentLoaded', function() {
			document.querySelectorAll('.faq-item').forEach(function(item) {
				var q = item.querySelector('.faq-q');
				q.addEventListener('click', function() {
					item.classList.toggle('open');
				});
			});
		});
	</script>

	<script type="application/ld+json" is:inline>
	{
		"@context": "https://schema.org",
		"@type": "Service",
		"name": "论文排版服务",
		"provider": {
			"@type": "Person",
			"name": "无名苗圃"
		},
		"description": "按学校格式规范代排版本科、硕士、博士毕业论文，含封面、目录、页眉页脚、参考文献、公式图表处理。",
		"offers": {
			"@type": "Offer",
			"price": "199",
			"priceCurrency": "CNY"
		},
		"areaServed": "CN"
	}
	</script>
</BaseLayout>
