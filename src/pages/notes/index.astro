---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const notes = (await getCollection('notes')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title={`笔记 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} >
		<style>
			main {
				width: var(--content-width);
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2.5em 1em;
			}
			.page-title {
				font-size: 1.45em;
				margin-bottom: 0.3em;
			}
			.page-desc {
				color: var(--text-secondary);
				font-size: 0.95em;
				margin-bottom: 1em;
			}
			.garden-marker {
				display: inline-block;
				font-size: 0.85em;
				color: var(--text-secondary);
				background: var(--accent-soft);
				border: 1px solid var(--border);
				border-radius: 999px;
				padding: 0.45em 1.2em;
				margin-bottom: 1.8em;
			}
			.search-box {
				max-width: 400px;
				margin-bottom: 2em;
				position: relative;
			}
			.search-box input {
				width: 100%;
				padding: 0.6em 1em 0.6em 2.5em;
				border: 1px solid var(--border);
				border-radius: var(--radius-md);
				font-size: 0.95em;
				background: var(--bg-elevated);
				color: var(--text);
				transition: border-color 0.2s, box-shadow 0.2s;
			}
			.search-box input:focus {
				outline: none;
				border-color: var(--accent);
				box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);
			}
			.search-box svg {
				position: absolute;
				left: 1em;
				top: 50%;
				transform: translateY(-50%);
				color: var(--text-secondary);
				pointer-events: none;
			}
			.no-results {
				text-align: center;
				color: var(--text-secondary);
				padding: 3em 0;
				display: none;
			}
			.no-results.visible {
				display: block;
			}
			.note-list {
				display: flex;
				flex-direction: column;
			}
			.note-item {
				display: flex;
				align-items: baseline;
				gap: 1em;
				padding: 0.75em 0.2em;
				border-bottom: 1px solid var(--border);
				text-decoration: none;
				color: inherit;
			}
			.note-item:hover .post-list-title {
				color: var(--accent);
			}
			.post-list-date {
				font-size: 0.78em;
				color: var(--text-secondary);
				white-space: nowrap;
				font-variant-numeric: tabular-nums;
				flex-shrink: 0;
			}
			.post-list-title {
				font-size: 0.95em;
				flex: 1;
				min-width: 0;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
				transition: color 0.15s;
			}
			.tag {
				font-size: 0.72em;
				padding: 0.15em 0.6em;
				border-radius: 999px;
				background: var(--accent-soft);
				color: var(--accent);
				white-space: nowrap;
				flex-shrink: 0;
			}
			.empty {
				text-align: center;
				color: var(--text-secondary);
				padding: 4em 0;
			}
			@media (max-width: 720px) {
				.note-item {
					gap: 0.6em;
				}
			}
		</style>
	<main>
			<h1 class="page-title">笔记</h1>
			<p class="page-desc">技术片段、工具用法和随手记录</p>
			<div class="garden-marker">🌱 自留区 —— 花园主的学习草稿，零散但正在生长。</div>
			<div class="search-box">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
				<input type="text" id="search-input" placeholder="搜索笔记..." />
			</div>
			<div class="no-results" id="no-results">没有找到匹配的笔记</div>
			<div class="note-list" id="note-list">
				{notes.length === 0 && (
					<div class="empty">🌱 苗圃还在整理，笔记即将发芽...</div>
				)}
				{notes.map((note) => (
					<a href={`/notes/${note.id}/`} class="note-item" data-search={`${note.data.title} ${note.data.description} ${note.data.tags?.join(" ") || ""}`}>
						<span class="post-list-date"><FormattedDate date={note.data.pubDate} /></span>
						<span class="post-list-title">{note.data.title}</span>
						{note.data.tags && note.data.tags.length > 0 && (
							<span class="tag">{note.data.tags[0]}</span>
						)}
					</a>
				))}
			</div>
		</main>
		<script is:inline>
			document.addEventListener('DOMContentLoaded', function() {
				var input = document.getElementById('search-input');
				var list = document.getElementById('note-list');
				var noResults = document.getElementById('no-results');
				if (!input || !list) return;
				var items = list.querySelectorAll('.note-item');
				input.addEventListener('input', function() {
					var q = input.value.trim().toLowerCase();
					var visible = 0;
					items.forEach(function(item) {
						var text = (item.dataset.search || '').toLowerCase();
						if (!q || text.indexOf(q) !== -1) {
							item.style.display = '';
							visible++;
						} else {
							item.style.display = 'none';
						}
					});
					noResults.classList.toggle('visible', visible === 0);
				});
			});
		</script>
</BaseLayout>
