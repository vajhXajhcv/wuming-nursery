---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const allPosts = [...(await getCollection('blog')), ...(await getCollection('notes'))]
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Group by year
const yearMap = new Map<number, typeof allPosts>();
allPosts.forEach((post) => {
	const year = post.data.pubDate.getFullYear();
	if (!yearMap.has(year)) yearMap.set(year, []);
	yearMap.get(year)!.push(post);
});

const sortedYears = Array.from(yearMap.entries()).sort((a, b) => b[0] - a[0]);
const totalPosts = allPosts.length;
---

<BaseLayout title={`归档 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} >
		<style>
			main {
				width: var(--content-width);
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2.5em 1em;
			}
			.page-title {
				font-size: 1.45em;
				margin-bottom: 0.3em;
			}
			.page-desc {
				color: var(--text-secondary);
				font-size: 0.95em;
				margin-bottom: 2em;
			}
			.year-group {
				margin-bottom: 2.2em;
			}
			.year-label {
				font-size: 1.15em;
				font-weight: 600;
				color: var(--text);
				margin-bottom: 0.2em;
				padding-bottom: 0.4em;
				border-bottom: 1px solid var(--border);
			}
			.year-count {
				font-size: 0.7em;
				font-weight: 400;
				color: var(--text-secondary);
				margin-left: 0.5em;
			}
			.post-item {
				display: flex;
				align-items: baseline;
				gap: 1em;
				padding: 0.6em 0.2em;
				border-bottom: 1px solid var(--border);
				text-decoration: none;
				color: inherit;
			}
			.post-item:hover .post-title {
				color: var(--accent);
			}
			.post-item:last-child {
				border-bottom: none;
			}
			.post-title {
				font-size: 0.95em;
				flex: 1;
				min-width: 0;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
				transition: color 0.15s;
			}
			.post-type {
				font-size: 0.72em;
				padding: 0.15em 0.6em;
				border-radius: 999px;
				background: var(--accent-soft);
				color: var(--accent);
				white-space: nowrap;
				flex-shrink: 0;
			}
			.post-date {
				font-size: 0.78em;
				color: var(--text-secondary);
				white-space: nowrap;
				font-variant-numeric: tabular-nums;
				flex-shrink: 0;
			}
			.empty {
				text-align: center;
				color: var(--text-secondary);
				padding: 4em 0;
			}
			@media (max-width: 720px) {
				.post-item {
					gap: 0.6em;
				}
			}
		</style>
	<main>
			<h1 class="page-title">归档</h1>
			<p class="page-desc">共 {totalPosts} 篇文章，按时间倒序排列</p>

			{allPosts.length === 0 && (
				<div class="empty">🌱 苗圃还很新，等种子发芽...</div>
			)}

			<div class="timeline">
				{sortedYears.map(([year, posts]) => (
					<div class="year-group">
						<div class="year-label">
							{year}
							<span class="year-count">{posts.length} 篇</span>
						</div>
						{posts.map((post) => (
							<a href={`/${post.collection}/${post.id}/`} class="post-item">
								<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
								<span class="post-title">{post.data.title}</span>
								<span class="post-type">{post.collection === 'blog' ? '文章' : '笔记'}</span>
							</a>
						))}
					</div>
				))}
			</div>
	</main>
</BaseLayout>
