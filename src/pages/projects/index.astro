---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const title = `项目 - ${SITE_TITLE}`;
const description = SITE_DESCRIPTION;

const projects = [
	{
		name: 'docx-formatter-cn',
		title: 'docx-formatter-cn',
		tagline: '中文 Word 文档智能排版工具',
		description: '把 Markdown 文本一键转换为符合中文排版规范的 Word 文档。支持标题、列表、代码块、表格等格式，适合技术写作与文档交付。',
		href: '/projects/docx-formatter-cn/',
		tags: ['Python', '工具', '中文排版'],
		status: '已发布',
	},
	{
		name: 'md2docx-online',
		title: '在线 Markdown 转 Word',
		tagline: '浏览器内一键论文排版',
		description: '在浏览器里把 Markdown 转成符合中文学术规范的 Word 文档，支持 LaTeX 公式、三线表与毕业论文模板。',
		href: '/tools/md2docx/',
		tags: ['在线工具', '论文排版'],
		status: '已发布',
	},
	{
		name: 'docx-formatter-docs',
		title: 'docx-formatter-cn 文档',
		tagline: '完整使用文档',
		description: 'docx-formatter-cn 的安装、配置与使用指南，包含命令行参数、模板说明和常见问题。',
		href: '/projects/docx-formatter-docs/',
		tags: ['文档', '工具'],
		status: '维护中',
	},
	{
		name: 'kaoyan',
		title: 'kaoyan · 考研志愿填报辅助',
		tagline: 'AI 驱动的院校推荐与志愿模拟工具',
		description: '覆盖院校库查询、智能推荐、志愿模拟与分数线分析，帮助考研学生用数据科学决策。数据仅供参考。',
		href: '/kaoyan/',
		tags: ['React', '数据可视化', '教育工具'],
		status: '实验版',
	},
	{
		name: 'triworld',
		title: 'TriWorld · 知识世界',
		tagline: '把碎片知识，连成系统认知',
		description: 'TriWorld 是一个面向终身学习者的知识探索平台原型，用“三个世界”的可视化结构，把零散的课程、概念与路径组织成可导航的系统认知地图。',
		href: '/triworld/',
		tags: ['React', '教育工具', '知识图谱'],
		status: '原型版',
	},
	{
		name: 'crypto-lab',
		title: 'Crypto Lab · 密码学实验室',
		tagline: '从零开始用 Python 跑通密码学核心概念',
		description: '一套面向初学者的密码学动手练习，涵盖古典密码、AES-GCM、哈希/HMAC、RSA 加密签名与 TLS 证书检查，配有好文档、CI 与 VS Code 支持。',
		href: '/projects/crypto-lab/',
		tags: ['Python', '密码学', '学习资源'],
		status: '维护中',
	},
];
---

<BaseLayout title={title} description={description} >
		<style>
			main {
				width: 800px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2em 1em;
			}
			.page-title {
				font-size: 1.45em;
				margin-bottom: 0.2em;
			}
			.page-desc {
				color: var(--text-secondary);
				margin-bottom: 2em;
				font-size: 0.95em;
			}
			.project-list {
				display: flex;
				flex-direction: column;
				gap: 1em;
			}
			.project-card {
				display: block;
				padding: 1.4em;
				border-radius: var(--radius-lg);
				background: var(--bg-elevated);
				border: 1px solid var(--border);
				text-decoration: none;
				color: inherit;
				transition: border-color 0.2s, box-shadow 0.2s;
			}
			.project-card:hover {
				border-color: var(--accent);
				box-shadow: var(--shadow-md);
			}
			.project-header {
				display: flex;
				align-items: flex-start;
				justify-content: space-between;
				gap: 1em;
				margin-bottom: 0.6em;
			}
			.project-title {
				font-size: 1.15em;
				font-weight: 700;
				margin: 0;
			}
			.project-tagline {
				color: var(--text-secondary);
				font-size: 0.88em;
				margin: 0.2em 0 0;
			}
			.project-status {
				flex-shrink: 0;
				padding: 0.15em 0.7em;
				border-radius: 999px;
				font-size: 0.72em;
				background: var(--accent-soft);
				color: var(--accent);
				font-weight: 500;
			}
			.project-description {
				color: var(--text-secondary);
				line-height: 1.7;
				margin-bottom: 1em;
				font-size: 0.92em;
			}
			.project-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4em;
			}
			.project-tags span {
				padding: 0.15em 0.6em;
				border-radius: var(--radius-sm);
				border: 1px solid var(--border);
				color: var(--text-secondary);
				font-size: 0.78em;
			}
			.empty {
				text-align: center;
				color: var(--text-secondary);
				padding: 4em 0;
			}
			@media (max-width: 720px) {
				.project-header {
					flex-direction: column;
					gap: 0.5em;
				}
			}
		</style>
	<main>
			<h1 class="page-title">项目</h1>
			<p class="page-desc">正在构建的工具与实验</p>

			{projects.length === 0 && (
				<div class="empty">🌱 项目列表还是空的，敬请期待。</div>
			)}

			<div class="project-list">
				{projects.map((project) => (
					<a href={project.href} class="project-card">
						<div class="project-header">
							<div>
								<h2 class="project-title">{project.title}</h2>
								<p class="project-tagline">{project.tagline}</p>
							</div>
							<span class="project-status">{project.status}</span>
						</div>
						<p class="project-description">{project.description}</p>
						<div class="project-tags">
							{project.tags.map((tag) => (
								<span>{tag}</span>
							))}
						</div>
					</a>
				))}
			</div>
	</main>
</BaseLayout>
