---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatCards from '../../components/dao/StatCards.astro';
import ChainStatus from '../../components/dao/ChainStatus.astro';
import ProposalCards from '../../components/dao/ProposalCards.astro';
import VoteBar from '../../components/dao/VoteBar.astro';
import { SITE_TITLE } from '../../consts';

const title = `DAO 总览 - ${SITE_TITLE}`;
const description = '无名苗圃共同体：公开账本、贡献上链、按贡献点治理、任何人可验证。';
---

<BaseLayout title={title} description={description}>
	<style is:global>
		.manifesto {
			margin-bottom: 1.5em;
			padding: 1.6em 1.8em;
			background: var(--bg-elevated);
			border: 1px solid var(--border);
			border-radius: var(--radius-lg);
		}
		.manifesto h1 {
			font-size: 1.6em;
			margin: 0 0 0.4em;
		}
		.manifesto p {
			color: var(--text-secondary);
			font-size: 0.95em;
			line-height: 1.8;
			margin: 0;
		}
		.two-col {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 1em;
			margin-bottom: 1em;
		}
		@media (max-width: 720px) {
			.two-col {
				grid-template-columns: 1fr;
			}
		}
		.dao-panel h2 {
			font-size: 1.05em;
			margin: 0 0 0.8em;
		}
		.board-row {
			display: flex;
			align-items: baseline;
			gap: 0.8em;
			padding: 0.45em 0;
			border-bottom: 1px dashed var(--border);
			font-size: 0.9em;
			flex-wrap: wrap;
		}
		.board-row:last-child {
			border-bottom: none;
		}
		.board-rank {
			color: var(--text-secondary);
			font-variant-numeric: tabular-nums;
			width: 1.6em;
		}
		.board-handle {
			font-weight: 600;
		}
		.board-pts {
			margin-left: auto;
			color: var(--text-secondary);
			font-variant-numeric: tabular-nums;
		}
		.board-pts strong {
			color: var(--accent);
		}
		.anchor-row {
			display: flex;
			flex-wrap: wrap;
			gap: 0.4em 1.2em;
			font-size: 0.85em;
			padding: 0.45em 0;
			border-bottom: 1px dashed var(--border);
			color: var(--text-secondary);
		}
		.anchor-row:last-child {
			border-bottom: none;
		}
		.anchor-row code {
			font-size: 0.9em;
		}
		.entry-cards {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
			gap: 0.8em;
			margin: 1.5em 0 2em;
		}
		.why-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
			gap: 0.8em;
			margin-bottom: 0.9em;
		}
		.why-card {
			background: var(--bg-elevated);
			border: 1px solid var(--border);
			border-radius: var(--radius-md);
			padding: 1em 1.1em;
		}
		.why-card .t {
			font-weight: 600;
			margin-bottom: 0.3em;
		}
		.why-card .d {
			font-size: 0.85em;
			color: var(--text-secondary);
			line-height: 1.7;
		}
		.why-honest {
			font-size: 0.85em;
			color: var(--text-secondary);
			line-height: 1.8;
			margin: 0 0 1em;
		}
		.why-cta {
			display: flex;
			gap: 0.8em;
			align-items: center;
			flex-wrap: wrap;
		}
		.entry-card {
			background: var(--bg-elevated);
			border: 1px solid var(--border);
			border-radius: var(--radius-md);
			padding: 1em 1.1em;
			text-decoration: none;
			color: var(--text);
		}
		.entry-card:hover {
			border-color: var(--accent);
		}
		.entry-card .t {
			font-weight: 600;
			margin-bottom: 0.2em;
		}
		.entry-card .d {
			font-size: 0.8em;
			color: var(--text-secondary);
		}
		.muted {
			color: var(--text-secondary);
			font-size: 0.88em;
		}
	</style>
	<main>
		<section class="manifesto">
			<h1>无名苗圃共同体</h1>
			<p>
				无名苗圃共同体是围绕本站形成的创作共同体：金库收支全部记录在公开账本上，贡献逐条上链，
				治理权重按贡献点计算，任何人都可以下载全链数据独立重放验证。无需信任任何个人——包括创始人——信任由密码学与公开性提供。
			</p>
		</section>

		<section class="card dao-panel">
			<h2>为什么加入？</h2>
			<div class="why-grid">
				<div class="why-card">
					<div class="t">🗳 真正的决策权</div>
					<div class="d">提案与投票决定金库怎么花、网站做什么内容、乃至治理规则本身。权重按贡献点计算，规则全部公开。</div>
				</div>
				<div class="why-card">
					<div class="t">⛓ 贡献永久留痕</div>
					<div class="d">每条贡献记录写入公开哈希链，并锚定到比特币。不可篡改、任何人可独立验证——比任何证书都硬。</div>
				</div>
				<div class="why-card">
					<div class="t">📖 成员免费读</div>
					<div class="d">全部付费内容对成员免费开放（批准后发放访问令牌）。付费内容目前还是实验，而你将参与决定它长成什么样。</div>
				</div>
				<div class="why-card">
					<div class="t">🎭 低门槛假名制</div>
					<div class="d">不要邮箱、不要手机号。一个化名 + 一对浏览器生成的密钥，就是你的全部身份。</div>
				</div>
			</div>
			<p class="why-honest">
				也要说清楚这不是什么：不发代币、不承诺财务回报、贡献点不可转让、不代表股权。
				现在加入最大的特别之处是——规则还没有定死，最早的成员将参与定义它。
			</p>
			<div class="why-cta">
				<a class="btn btn-primary" href="/dao/join">申请加入 →</a>
				<a class="btn btn-outline" href="/dao/charter">先读章程</a>
			</div>
		</section>

		<StatCards>
			<div class="stat-card">
				<div class="stat-label">金库收入</div>
				<div class="stat-value income" id="stat-in">—</div>
			</div>
			<div class="stat-card">
				<div class="stat-label">金库支出</div>
				<div class="stat-value expense" id="stat-out">—</div>
			</div>
			<div class="stat-card">
				<div class="stat-label">金库结余</div>
				<div class="stat-value" id="stat-balance">—</div>
			</div>
			<div class="stat-card">
				<div class="stat-label">在册成员</div>
				<div class="stat-value" id="stat-members">—</div>
			</div>
			<div class="stat-card">
				<div class="stat-label">提案数</div>
				<div class="stat-value" id="stat-proposals">—</div>
				<div class="stat-sub" id="stat-proposals-sub"></div>
			</div>
			<div class="stat-card">
				<div class="stat-label">最近锚定</div>
				<div class="stat-value" id="stat-anchor">—</div>
				<div class="stat-sub" id="stat-anchor-sub"></div>
			</div>
		</StatCards>

		<ChainStatus />

		<div class="two-col">
			<section class="card dao-panel">
				<h2>贡献榜 Top 10</h2>
				<div id="board" class="muted">加载中…</div>
			</section>
			<section class="card dao-panel">
				<h2>进行中的提案</h2>
				<div id="active-proposals" class="muted">加载中…</div>
			</section>
		</div>

		<section class="card dao-panel">
			<h2>锚定历史（OpenTimestamps）</h2>
			<div id="anchors" class="muted">加载中…</div>
		</section>

		<div class="entry-cards">
			<a class="entry-card" href="/dao/proposals">
				<div class="t">提案</div>
				<div class="d">浏览全部治理提案</div>
			</a>
			<a class="entry-card" href="/dao/members">
				<div class="t">成员</div>
				<div class="d">在册成员与贡献点</div>
			</a>
			<a class="entry-card" href="/dao/join">
				<div class="t">加入</div>
				<div class="d">生成密钥，申请成为成员</div>
			</a>
			<a class="entry-card" href="/dao/charter">
				<div class="t">章程</div>
				<div class="d">治理规则与信任模型</div>
			</a>
			<a class="entry-card" href="/ledger">
				<div class="t">公开账本</div>
				<div class="d">金库每一笔收支</div>
			</a>
		</div>
	</main>

	<!-- 动态内容由 JS 渲染：注入 .prop-item/.vote-bar 的全局样式 -->
	<ProposalCards />
	<VoteBar />

	<script>
		import { proposalStatus } from '../../lib/dao-core';
		import {
			loadChain,
			escapeHtml,
			fmtTime,
			fmtPts,
			fmtMoney,
			proposalItemHtml,
			errorHtml,
			bindRetry,
		} from '../../lib/dao-ui';

		const $ = (id: string) => document.getElementById(id) as HTMLElement;

		async function init() {
			let c;
			try {
				c = await loadChain();
			} catch (err) {
				const msg = (err as Error).message || '加载失败，请刷新重试。';
				$('board').innerHTML = errorHtml(msg);
				bindRetry($('board'), init);
				$('active-proposals').innerHTML = errorHtml(msg);
				bindRetry($('active-proposals'), init);
				$('anchors').innerHTML = '<span class="muted">加载失败。</span>';
				return;
			}
			const { records, state } = c;
			const now = Date.now();

			// 金库统计：只取 income/expense
			let tin = 0;
			let tout = 0;
			for (const r of records) {
				if (r.type === 'income') tin += parseFloat(r.amount) || 0;
				else if (r.type === 'expense') tout += parseFloat(r.amount) || 0;
			}
			$('stat-in').textContent = fmtMoney(tin);
			$('stat-out').textContent = fmtMoney(tout);
			$('stat-balance').textContent = fmtMoney(tin - tout);

			const memberCount = Object.values(state.members).filter((m) => !m.removed).length;
			$('stat-members').textContent = String(memberCount);

			const props = Object.values(state.proposals);
			const activeProps = props
				.filter((p) => proposalStatus(p, now) === 'active')
				.sort((a, b) => a.data.deadline - b.data.deadline);
			const passedCount = props.filter((p) => {
				const s = proposalStatus(p, now);
				return s === 'passed' || s === 'executed';
			}).length;
			$('stat-proposals').textContent = String(props.length);
			$('stat-proposals-sub').textContent = `投票中 ${activeProps.length} · 已通过 ${passedCount}`;

			if (state.anchors.length) {
				const a = state.anchors[state.anchors.length - 1];
				$('stat-anchor').textContent = '#' + a.data.anchoredSeq;
				$('stat-anchor-sub').textContent = fmtTime(a.ts);
			} else {
				$('stat-anchor').textContent = '—';
			}

			// 贡献榜
			const board = Object.entries(state.points)
				.map(([handle, p]) => ({ handle, ...p }))
				.sort((a, b) => b.total - a.total)
				.slice(0, 10);
			$('board').innerHTML = board.length
				? board
						.map(
							(b, i) =>
								`<div class="board-row"><span class="board-rank">${i + 1}</span>` +
								`<span class="board-handle">${escapeHtml(b.handle)}</span>` +
								`<span class="board-pts"><strong>${fmtPts(b.total)}</strong> 点（资金 ${fmtPts(b.money)} · 劳动 ${fmtPts(b.labor)}）</span></div>`,
						)
						.join('')
				: '<div class="empty">暂无贡献记录</div>';

			// 进行中的提案
			$('active-proposals').innerHTML = activeProps.length
				? activeProps.map((p) => proposalItemHtml(records, p)).join('')
				: '<div class="empty">暂无进行中的提案</div>';

			// 锚定历史（404 容忍；index.json 为数组，条目 {seq, hash, ts, files:{日历:文件名}}）
			try {
				const ar = await fetch('/dao/anchors/index.json');
				if (!ar.ok) throw new Error('no anchors');
				const aj = await ar.json();
				const list: any[] = Array.isArray(aj) ? aj : aj.anchors || [];
				$('anchors').innerHTML = list.length
					? list
							.map((e) => {
								const seq = e.anchoredSeq ?? e.seq;
								const hash = String(e.anchoredHash ?? e.hash ?? '');
								const ts = e.ts ?? e.time;
								const files: string[] = e.files
									? Object.values(e.files)
									: [e.otsFile ?? e.ots].filter(Boolean);
								return (
									`<div class="anchor-row"><span>seq #${escapeHtml(seq)}</span>` +
									`<code>${escapeHtml(hash.slice(0, 16))}…</code>` +
									(ts ? `<span>${fmtTime(Number(ts))}</span>` : '') +
									files
										.map(
											(f) =>
												`<span>证明：<a href="/dao/anchors/${encodeURIComponent(f)}">${escapeHtml(f)}</a></span>`,
										)
										.join('') +
									`</div>`
								);
							})
							.join('')
					: '<span class="muted">暂无锚定</span>';
			} catch {
				$('anchors').innerHTML = '<span class="muted">暂无锚定</span>';
			}
		}

		init();
	</script>
</BaseLayout>
