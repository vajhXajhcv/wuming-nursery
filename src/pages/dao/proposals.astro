---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProposalCards from '../../components/dao/ProposalCards.astro';
import VoteBar from '../../components/dao/VoteBar.astro';
import { SITE_TITLE } from '../../consts';

const title = `提案 - ${SITE_TITLE}`;
const description = '无名苗圃共同体治理提案：支出、文本决议与参数变更。';
---

<BaseLayout title={title} description={description}>
	<style is:global>
		.page-header {
			margin-bottom: 1.5em;
			display: flex;
			align-items: baseline;
			gap: 1em;
			flex-wrap: wrap;
		}
		.page-header h1 {
			font-size: 1.5em;
			margin: 0 0 0.3em;
		}
		.page-header p {
			color: var(--text-secondary);
			font-size: 0.9em;
			margin: 0;
		}
		.new-link {
			margin-left: auto;
			font-size: 0.88em;
		}
		.group-title {
			font-size: 1.05em;
			margin: 1.6em 0 0.7em;
			padding-bottom: 0.35em;
			border-bottom: 1px solid var(--border);
		}
	</style>
	<main>
		<div class="page-header">
			<div>
				<h1>治理提案</h1>
				<p>支出、文本决议与参数变更。一「点」一票，权重按提案高度快照。</p>
			</div>
			<a class="new-link" href="/dao/propose">＋ 发起提案</a>
		</div>
		<div id="groups"><div class="empty">⏳ 加载中…</div></div>
	</main>

	<!-- 提案卡片与投票条由 JS 渲染，这里仅注入全局样式 -->
	<ProposalCards />
	<VoteBar />

	<script>
		import { proposalStatus } from '../../lib/dao-core';
		import type { ProposalStatus } from '../../lib/dao-core';
		import { loadChain, proposalCardHtml, errorHtml, bindRetry } from '../../lib/dao-ui';

		const GROUPS: { status: ProposalStatus; label: string }[] = [
			{ status: 'active', label: '投票中' },
			{ status: 'expired', label: '待关闭' },
			{ status: 'passed', label: '已通过' },
			{ status: 'rejected', label: '已拒绝' },
			{ status: 'executed', label: '已执行' },
		];

		async function init() {
			const container = document.getElementById('groups') as HTMLElement;
			let c;
			try {
				c = await loadChain();
			} catch (err) {
				container.innerHTML = errorHtml((err as Error).message || '加载失败，请刷新重试。');
				bindRetry(container, init);
				return;
			}
			const { records, state } = c;
			const now = Date.now();
			const props = Object.values(state.proposals).sort((a, b) => b.pid - a.pid);
			if (!props.length) {
				container.innerHTML = '<div class="empty">暂无提案。</div>';
				return;
			}
			let html = '';
			for (const g of GROUPS) {
				const list = props.filter((p) => proposalStatus(p, now) === g.status);
				if (!list.length) continue;
				html += `<h2 class="group-title">${g.label}（${list.length}）</h2>`;
				for (const p of list) html += proposalCardHtml(records, p, g.status);
			}
			container.innerHTML = html;
		}

		init();
	</script>
</BaseLayout>
