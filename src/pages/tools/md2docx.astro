	<script is:inline>
		(function() {
			const PYODIDE_VERSION = '0.27.5';
			// 多源回退：jsdelivr 不可达时自动切换 npmmirror
			const PYODIDE_SOURCES = [
				'https://cdn.jsdelivr.net/pyodide/v' + PYODIDE_VERSION + '/full/',
				'https://registry.npmmirror.com/pyodide/' + PYODIDE_VERSION + '/files/full/',
			];
			const LOAD_TIMEOUT_MS = 90000;
			const CONVERT_TIMEOUT_MS = 120000;
			const MAX_INPUT_BYTES = 2 * 1024 * 1024;
			const WHEELS = [
				'/tools/md2docx/wheels/python_docx-1.2.0-py3-none-any.whl',
				'/tools/md2docx/wheels/latex2mathml-3.81.0-py3-none-any.whl',
				'/tools/md2docx/wheels/docx_formatter_cn-0.1.0-py3-none-any.whl',
			];

			const input = document.getElementById('md-input');
			const template = document.getElementById('template');
			const convertBtn = document.getElementById('convert');
			const sampleBtn = document.getElementById('load-sample');
			const status = document.getElementById('status');
			const result = document.getElementById('result');
			const resultMsg = document.getElementById('result-msg');
			const download = document.getElementById('download');

			// 共享 Promise：并发调用共享同一次加载；失败后复位，允许重试
			let pyodidePromise = null;
			let lastObjectUrl = null;

			function setStatus(message, busy) {
				status.innerHTML = busy ? '<span class="dot"></span>' + message : message;
			}

			function setError(message) {
				status.innerHTML = '<span style="color:#dc2626;">错误：' + message + '（可重试）</span>';
			}

			function withTimeout(promise, ms, label) {
				return Promise.race([
					promise,
					new Promise(function(_, reject) {
						setTimeout(function() {
							reject(new Error(label + '超时，请检查网络后重试'));
						}, ms);
					}),
				]);
			}

			function friendlyMessage(e) {
				const raw = (e && e.message) || String(e);
				if (/Failed to fetch|NetworkError|fetch failed|Load failed/i.test(raw)) {
					return '网络加载失败，请检查网络（或切换网络环境）后重新点击「开始转换」。';
				}
				if (/超时/.test(raw)) return raw;
				// Python traceback 很长，只保留最后一行关键错误
				const lines = raw.split('\n').map(function(s) { return s.trim(); }).filter(Boolean);
				const last = lines.length ? lines[lines.length - 1] : raw;
				return last.length > 200 ? last.slice(0, 200) + '…' : last;
			}

			function loadScript(src) {
				return new Promise(function(resolve, reject) {
					const s = document.createElement('script');
					s.src = src;
					s.onload = resolve;
					s.onerror = function() { reject(new Error('脚本加载失败（' + src + '）')); };
					document.head.appendChild(s);
				});
			}

			async function loadPyodideEngine() {
				let lastError = null;
				for (const source of PYODIDE_SOURCES) {
					try {
						setStatus('正在加载 Python 运行环境（首次约 10-20 MB）...', true);
						if (typeof loadPyodide === 'undefined') {
							await withTimeout(loadScript(source + 'pyodide.js'), LOAD_TIMEOUT_MS, '运行环境加载');
						}
						const py = await withTimeout(
							loadPyodide({ indexURL: source }), LOAD_TIMEOUT_MS, '运行环境加载'
						);
						setStatus('正在加载基础依赖（lxml、PyYAML）...', true);
						await withTimeout(
							py.loadPackage(['lxml', 'pyyaml', 'typing-extensions']), LOAD_TIMEOUT_MS, '依赖加载'
						);
						setStatus('正在安装文档转换组件...', true);
						const micropip = py.pyimport('micropip');
						for (const wheel of WHEELS) {
							await micropip.install(new URL(wheel, location.href).href);
						}
						setStatus('环境就绪，可以转换了。', false);
						return py;
					} catch (e) {
						console.error('Pyodide 源加载失败：' + source, e);
						lastError = e;
					}
				}
				throw lastError || new Error('运行环境加载失败');
			}

			function ensurePyodide() {
				if (!pyodidePromise) {
					pyodidePromise = loadPyodideEngine().catch(function(err) {
						pyodidePromise = null; // 复位，下次点击可重新加载
						throw err;
					});
				}
				return pyodidePromise;
			}

			sampleBtn.addEventListener('click', function() {
				if (window.__MD2DOCX_SAMPLE__) {
					input.value = window.__MD2DOCX_SAMPLE__;
					setStatus('已载入示例，可点击「开始转换」。', false);
					result.classList.remove('visible');
				}
			});

			convertBtn.addEventListener('click', async function() {
				const md = input.value.trim();
				if (!md) {
					setError('请先粘贴 Markdown 内容。');
					return;
				}
				if (new Blob([md]).size > MAX_INPUT_BYTES) {
					setError('文档超过 2 MB，超出在线轻量版能力，请使用 Pro 桌面版处理大文件或批量转换。');
					return;
				}
				convertBtn.disabled = true;
				result.classList.remove('visible');
				try {
					const py = await ensurePyodide();
					setStatus('正在排版并生成 Word 文档...', true);

					const templateName = template.value;
					const selectedOption = template.options[template.selectedIndex];
					const isJsonTemplate = selectedOption.dataset.source === 'json';
					const mdB64 = btoa(unescape(encodeURIComponent(md)));
					const tplB64 = btoa(unescape(encodeURIComponent(templateName)));

					if (isJsonTemplate) {
						const tplUrl = '/tools/md2docx/templates/' + templateName + '.json';
						setStatus('正在加载期刊模板...', true);
						const tplResp = await fetch(tplUrl);
						if (!tplResp.ok) throw new Error('模板文件加载失败：' + tplUrl);
						const tplBytes = new Uint8Array(await tplResp.arrayBuffer());
						py.FS.writeFile('/home/pyodide/template_' + templateName + '.json', tplBytes);
					}

					const code = `
from docx_formatter import convert_markdown_to_docx
from docx_formatter.config import load_template_from_json, get_preset
from docx_formatter.converter.markdown_parser import parse_markdown_with_meta
from docx_formatter.converter.docx_builder import build_docx
import base64, os

md_text = base64.b64decode("${mdB64}").decode("utf-8")
