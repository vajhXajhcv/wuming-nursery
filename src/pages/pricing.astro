---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';

const title = `定价方案 - ${SITE_TITLE}`;
const description = 'docx-formatter-cn 免费开源 CLI、Pro 桌面版与论文排版代做服务的定价方案。';

const plans = [
	{
		name: '免费版',
		price: '¥0',
		period: '永久',
		desc: '开源 CLI + 在线工具，适合动手能力强或想先体验的用户。',
		features: [
			'开源 CLI 工具',
			'在线 Markdown 转 Word（浏览器内运行）',
			'5 种内置模板（毕业论文/课程论文/武汉理工毕业设计/数学建模/公文）',
			'LaTeX 公式 → Word 原生 OMML',
			'三线表与自动编号',
			'社区支持',
		],
		cta: '在线免费试用',
		ctaHref: '/tools/md2docx',
		ctaExternal: false,
		highlight: false,
	},
	{
		name: 'Pro 个人版',
		price: '¥49',
		period: '买断制',
		desc: '为论文写作量身定做的桌面应用，安装即用。',
		features: [
			'PySide6 GUI 拖拽转换',
			'批量 Markdown → Word',
			'中文学位论文 + arXiv / Nature / Science / IEEE / APA 模板',
			'自定义 JSON/YAML 模板',
			'本地图片与相对路径解析',
			'支持现有 Word 重新排版',
			'一次购买，永久更新',
		],
		cta: '去爱发电购买',
		ctaHref: 'https://afdian.com/a/jk342joy',
		ctaExternal: true,
		highlight: true,
	},
	{
		name: '论文排版服务',
		price: '¥199 起',
		period: '按篇计费',
		desc: '没时间调格式？把论文和要求发我，我按学校模板排好。',
		features: [
			'本科/硕士/毕业论文格式调整',
			'封面、目录、页眉页脚、参考文献',
			'公式、图表、三线表规范处理',
			'交付后 2 轮免费修改',
			'加急 24h 可选',
		],
		cta: '了解详情',
		ctaHref: '/services/thesis-formatting',
		ctaExternal: false,
		highlight: false,
	},
];

const faqs = [
	{ q: 'Pro 版和免费版的核心区别是什么？', a: '核心排版引擎完全相同。Pro 版提供 GUI、批量转换、自定义模板和本地图片路径解析，适合不想用命令行的论文作者。' },
	{ q: '购买 Pro 后如何获取更新？', a: '目前通过爱发电发放下载链接与更新通知，购买后永久免费获取后续版本。' },
	{ q: '可以开具发票吗？', a: '可以。通过爱发电或企业转账付款后，可申请开具发票。' },
	{ q: '学校模板定制怎么收费？', a: '如果只是现有字段微调，通常包含在 Pro 版支持范围内；复杂学校模板定制按工时另议，可在论文排版服务中沟通。' },
	{ q: '在线工具和 Pro 版有什么区别？', a: '在线工具在浏览器内运行，适合单次快速体验，暂不支持本地图片；Pro 版是桌面软件，支持批量、自定义模板和完整本地文件工作流。' },
];
---

<BaseLayout title={title} description={description}>
	<style>
		main {
			width: var(--wide-width);
			max-width: calc(100% - 2em);
			margin: auto;
			padding: 2em 1em 4em;
		}
		.hero {
			padding: 1em 0 1.5em;
		}
		.hero h1 {
			font-size: 1.5em;
			margin: 0 0 0.3em;
		}
		.hero p {
			color: var(--text-secondary);
			font-size: 0.95em;
			max-width: 560px;
			margin: 0;
			line-height: 1.7;
		}

		.plans {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
			gap: 1.2em;
			margin: 2em 0;
			align-items: start;
		}
		.plan-card {
			background: var(--bg-elevated);
			border: 1px solid var(--border);
			border-radius: var(--radius-lg);
			padding: 1.6em;
			display: flex;
			flex-direction: column;
			position: relative;
			transition: border-color 0.2s, box-shadow 0.2s;
		}
		.plan-card:hover {
			border-color: var(--accent);
		}
		.plan-card.highlight {
			border-color: var(--accent);
			box-shadow: 0 0 0 3px var(--accent-soft);
		}
		.badge {
			position: absolute;
			top: -0.7em;
			right: 1em;
			background: var(--accent);
			color: white;
			font-size: 0.75em;
			font-weight: 700;
			padding: 0.3em 0.8em;
			border-radius: 999px;
		}
		.plan-card h2 {
			margin: 0 0 0.2em;
			font-size: 1.25em;
		}
		.plan-price {
			font-size: 1.7em;
			font-weight: 800;
			color: var(--accent);
			margin: 0.2em 0 0.6em;
		}
		.plan-price span {
			font-size: 0.5em;
			color: var(--text-secondary);
			font-weight: 500;
		}
		.plan-desc {
			color: var(--text-secondary);
			font-size: 0.92em;
			line-height: 1.6;
			margin-bottom: 1em;
		}
		.plan-features {
			list-style: none;
			padding: 0;
			margin: 0 0 1.5em;
			flex: 1;
		}
		.plan-features li {
			padding: 0.4em 0 0.4em 1.4em;
			position: relative;
			font-size: 0.9em;
		}
		.plan-features li::before {
			content: '✓';
			position: absolute;
			left: 0;
			color: var(--accent);
			font-weight: 700;
		}
		.plan-cta {
			display: block;
			text-align: center;
			padding: 0.65em 1em;
			border-radius: var(--radius-md);
			font-weight: 600;
			font-size: 0.92em;
			text-decoration: none;
			border: 1px solid transparent;
			transition: background 0.15s, border-color 0.2s, color 0.15s;
		}
		.plan-cta.primary {
			background: var(--accent);
			color: white;
		}
		.plan-cta.primary:hover {
			background: var(--accent-dark);
			color: white;
		}
		.plan-cta.secondary {
			background: transparent;
			color: var(--text);
			border-color: var(--border);
		}
		.plan-cta.secondary:hover {
			border-color: var(--accent);
			color: var(--accent);
		}

		.compare-section {
			margin: 3em 0;
		}
		.section-title {
			font-size: 1.4em;
			margin-bottom: 1em;
			padding-bottom: 0.4em;
			border-bottom: 1px solid var(--border);
		}
		.compare-table {
			width: 100%;
			border-collapse: collapse;
			font-size: 0.92em;
		}
		.compare-table th,
		.compare-table td {
			padding: 0.7em 0.8em;
			border-bottom: 1px solid var(--border);
			text-align: left;
		}
		.compare-table th {
			color: var(--text-secondary);
			font-weight: 600;
		}
		.compare-table td:nth-child(n+2) {
			text-align: center;
		}

		.faq-section {
			margin: 3em 0 2em;
		}
		.faq-item {
			background: var(--bg-elevated);
			border-radius: var(--radius-md);
			border: 1px solid var(--border);
			margin-bottom: 0.8em;
			overflow: hidden;
		}
		.faq-q {
			padding: 1em 1.2em;
			font-weight: 600;
			cursor: pointer;
			display: flex;
			justify-content: space-between;
			align-items: center;
			transition: background 0.15s;
		}
		.faq-q:hover {
			background: var(--accent-soft);
		}
		.faq-arrow {
			font-size: 0.8em;
			color: var(--text-secondary);
			transition: transform 0.2s;
		}
		.faq-item.open .faq-arrow {
			transform: rotate(180deg);
		}
		.faq-a {
			max-height: 0;
			overflow: hidden;
			transition: max-height 0.3s ease;
		}
		.faq-item.open .faq-a {
			max-height: 300px;
		}
		.faq-a-inner {
			padding: 0 1.2em 1em;
			color: var(--text-secondary);
			line-height: 1.7;
			font-size: 0.95em;
		}
		@media (max-width: 720px) {
			.compare-table { font-size: 0.85em; }
		}
	</style>

	<main>
		<section class="hero">
			<h1>选择适合你的方案</h1>
			<p>无论你是想自己动手，还是省时间交给专业排版，都有一个合适的选项。</p>
		</section>

		<section class="plans">
			{plans.map((plan) => (
				<div class={`plan-card ${plan.highlight ? 'highlight' : ''}`}>
					{plan.highlight && <span class="badge">推荐</span>}
					<h2>{plan.name}</h2>
					<div class="plan-price">{plan.price}<span> / {plan.period}</span></div>
					<p class="plan-desc">{plan.desc}</p>
					<ul class="plan-features">
						{plan.features.map((f) => <li>{f}</li>)}
					</ul>
					<a
						href={plan.ctaHref}
						class={`plan-cta ${plan.highlight ? 'primary' : 'secondary'}`}
						target={plan.ctaExternal ? '_blank' : undefined}
						rel={plan.ctaExternal ? 'noopener' : undefined}
					>
						{plan.cta}
					</a>
				</div>
			))}
		</section>

		<section class="compare-section">
			<h2 class="section-title">功能对比</h2>
			<table class="compare-table">
				<thead>
					<tr>
						<th>功能</th>
						<th>免费版</th>
						<th>Pro 版</th>
						<th>服务</th>
					</tr>
				</thead>
				<tbody>
					<tr><td>Markdown → Word</td><td>✓</td><td>✓</td><td>✓</td></tr>
					<tr><td>LaTeX 公式 → OMML</td><td>✓</td><td>✓</td><td>✓</td></tr>
					<tr><td>三线表 / 自动编号</td><td>✓</td><td>✓</td><td>✓</td></tr>
					<tr><td>GUI 桌面应用</td><td>—</td><td>✓</td><td>—</td></tr>
					<tr><td>批量转换</td><td>—</td><td>✓</td><td>协商</td></tr>
					<tr><td>中文论文模板</td><td>✓</td><td>✓</td><td>✓</td></tr>
					<tr><td>期刊 / 预印本模板</td><td>在线版</td><td>✓</td><td>✓</td></tr>
					<tr><td>自定义模板</td><td>CLI 编辑</td><td>✓</td><td>✓</td></tr>
					<tr><td>本地图片路径解析</td><td>—</td><td>✓</td><td>✓</td></tr>
					<tr><td>人工代排版</td><td>—</td><td>—</td><td>✓</td></tr>
				</tbody>
			</table>
		</section>

		<section class="faq-section">
			<h2 class="section-title">常见问题</h2>
			{faqs.map((f, i) => (
				<div class="faq-item" data-faq={i}>
					<div class="faq-q">
						{f.q}
						<span class="faq-arrow">▼</span>
					</div>
					<div class="faq-a">
						<div class="faq-a-inner">{f.a}</div>
					</div>
				</div>
			))}
		</section>
	</main>

	<script is:inline>
		document.addEventListener('DOMContentLoaded', function() {
			document.querySelectorAll('.faq-item').forEach(function(item) {
				var q = item.querySelector('.faq-q');
				q.addEventListener('click', function() {
					item.classList.toggle('open');
				});
			});
		});
	</script>

	<script type="application/ld+json" is:inline>
	{
		"@context": "https://schema.org",
		"@type": "Product",
		"name": "docx-formatter-cn",
		"description": "中文 Word 文档智能排版工具，支持 Markdown 转 Word、LaTeX 公式与三线表。",
		"offers": [
			{
				"@type": "Offer",
				"name": "免费版",
				"price": "0",
				"priceCurrency": "CNY"
			},
			{
				"@type": "Offer",
				"name": "Pro 个人版",
				"price": "49",
				"priceCurrency": "CNY"
			}
		]
	}
	</script>
</BaseLayout>
