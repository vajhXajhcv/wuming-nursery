/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=15552000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://challenges.cloudflare.com https://cdn.jsdelivr.net https://fastly.jsdelivr.net https://testingcf.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com https://cdn.jsdelivr.net https://fastly.jsdelivr.net https://testingcf.jsdelivr.net; media-src 'self'; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://formspree.io https://buttondown.email
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  ! Access-Control-Allow-Origin

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# 在线工具运行时资源：文件名版本锁定，可长期缓存
/tools/md2docx/pyodide/*
  Cache-Control: public, max-age=31536000, immutable

/tools/md2docx/wheels/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate
